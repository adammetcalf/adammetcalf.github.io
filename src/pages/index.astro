---
const projects = [
  {
    title: "Robotics",
    description:
      "Research and development of robotic systems, control architectures and mechatronic platforms.",
    href: "#",
  },
  {
    title: "Systems Engineering",
    description:
      "Design and integration of complex hardware and software systems across industrial applications.",
    href: "#",
  },
  {
    title: "Software",
    description:
      "Software architecture, embedded systems, automation and engineering tools.",
    href: "#",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Adam Metcalf — Robotics, Systems Engineering and Software."
    />

    <title>Adam Metcalf</title>

    <style>
      :root {
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;

        color: #1c1c1c;
        background: #fafafa;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
      }

      main {
        width: min(1100px, calc(100% - 3rem));
        margin: auto;
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;

        width: min(1100px, calc(100% - 3rem));
        margin: auto;
        padding: 2rem 0;
      }

      nav a {
        color: inherit;
        text-decoration: none;
      }

      .nav-links {
        display: flex;
        gap: 2rem;
      }

      .name {
        font-weight: 700;
      }

      .hero {
        min-height: 70vh;

        display: flex;
        flex-direction: column;
        justify-content: center;

        max-width: 850px;
      }

      .hero h1 {
        margin: 0;

        font-size: clamp(3.5rem, 9vw, 7rem);
        line-height: 0.95;
        letter-spacing: -0.05em;
      }

      .hero h2 {
        margin: 1.5rem 0;

        font-size: clamp(1.3rem, 3vw, 2rem);
        font-weight: 400;
      }

      .hero p {
        max-width: 700px;

        font-size: 1.2rem;
        line-height: 1.7;

        color: #555;
      }

      section {
        padding: 6rem 0;
      }

      section h2 {
        font-size: 2rem;
        margin-bottom: 3rem;
      }

      .projects {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
      }

      .project {
        border-top: 2px solid #1c1c1c;
        padding-top: 1.5rem;
      }

      .project h3 {
        font-size: 1.4rem;
      }

      .project p {
        color: #555;
        line-height: 1.6;
      }

      .project a {
        color: inherit;
        font-weight: 600;
      }

      .about {
        max-width: 750px;

        font-size: 1.2rem;
        line-height: 1.8;
      }

      footer {
        width: min(1100px, calc(100% - 3rem));

        margin: auto;
        padding: 3rem 0;

        border-top: 1px solid #ddd;

        display: flex;
        justify-content: space-between;
      }

      footer a {
        color: inherit;
      }

      @media (max-width: 700px) {
        .projects {
          grid-template-columns: 1fr;
        }

        .nav-links {
          gap: 1rem;
        }

        .hero {
          min-height: 60vh;
        }
      }
    </style>
  </head>

  <body>
    <nav>
      <a class="name" href="/">Adam Metcalf</a>

      <div class="nav-links">
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>

    <main>
      <section class="hero">
        <h1>Adam<br />Metcalf</h1>

        <h2>Robotics · Systems Engineering · Software</h2>

        <p>
          Engineer and researcher specialising in robotics, control,
          mechatronics and the integration of complex hardware and software
          systems.
        </p>
      </section>

      <section id="projects">
        <h2>Selected Work</h2>

        <div class="projects">
          {
            projects.map((project) => (
              <article class="project">
                <h3>{project.title}</h3>

                <p>{project.description}</p>

                <a href={project.href}>View project →</a>
              </article>
            ))
          }
        </div>
      </section>

      <section id="about">
        <h2>About</h2>

        <div class="about">
          <p>
            My work sits at the intersection of robotics, software and systems
            engineering. I have experience developing robotic research
            platforms, industrial control systems, automated test equipment and
            complex multidisciplinary engineering systems.
          </p>

          <p>
            I am particularly interested in system architecture, control,
            automation and building reliable software that interfaces with the
            physical world.
          </p>
        </div>
      </section>
    </main>

    <footer id="contact">
      <span>© {new Date().getFullYear()} Adam Metcalf</span>

      <div>
        <a href="https://www.github.com/adammetcalf">GitHub</a>
        &nbsp;&nbsp;
        <a href="https://www.linkedin.com/in/adammetcalf/">LinkedIn</a>
      </div>
    </footer>
  </body>
</html>