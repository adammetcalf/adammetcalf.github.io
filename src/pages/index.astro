---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Adam Metcalf">
  <main>
    <section class="hero">
      <h1>Adam<br />Metcalf</h1>

      <h2>Robotics · Systems Engineering · Software</h2>

      <p>
        Engineer and researcher specialising in robotics, control,
        mechatronics and the integration of complex hardware and software
        systems.
      </p>
    </section>

    <section>
      <h2>Explore</h2>

      <div class="links">
        <a class="link-card" href="/projects">
          <h3>Projects</h3>

          <p>
            A collection of engineering, robotics, software, electronics,
            mathematics and research projects.
          </p>

          <span class="arrow">Explore projects →</span>
        </a>

        <a class="link-card" href="/cv">
          <h3>CV</h3>

          <p>
            Professional experience, education, technical skills and selected
            engineering work.
          </p>

          <span class="arrow">View CV →</span>
        </a>
      </div>
    </section>

    <section id="about">
      <h2>About</h2>

      <div class="about">
        <p>
          My work sits at the intersection of robotics, software and systems
          engineering. I have experience developing robotic research
          platforms, industrial control systems, automated test equipment and
          complex multidisciplinary engineering systems.
        </p>

        <p>
          I am particularly interested in system architecture, control,
          automation and building reliable software that interfaces with the
          physical world.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    width: min(1100px, calc(100% - 3rem));
    margin: auto;
  }

  .hero {
    min-height: 70vh;

    display: flex;
    flex-direction: column;
    justify-content: center;

    max-width: 850px;
  }

  .hero h1 {
    margin: 0;

    font-size: clamp(3.5rem, 9vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .hero h2 {
    margin: 1.5rem 0;

    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: 400;
  }

  .hero p {
    max-width: 700px;

    font-size: 1.2rem;
    line-height: 1.7;

    color: #555;
  }

  section {
    padding: 6rem 0;
  }

  section h2 {
    font-size: 2rem;
    margin-bottom: 3rem;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
  }

  .link-card {
    display: block;

    border-top: 2px solid #1c1c1c;
    padding-top: 2rem;

    color: inherit;
    text-decoration: none;
  }

  .link-card h3 {
    margin: 0 0 1rem;

    font-size: 2rem;
  }

  .link-card p {
    max-width: 450px;

    color: #555;
    line-height: 1.7;
    font-size: 1.1rem;
  }

  .link-card .arrow {
    display: inline-block;
    margin-top: 1rem;

    font-weight: 600;
    text-decoration: underline;

    transition: transform 0.15s ease;
  }

  .link-card:hover .arrow {
    transform: translateX(4px);
  }

  .about {
    max-width: 750px;

    font-size: 1.2rem;
    line-height: 1.8;
  }

  @media (max-width: 700px) {
    .links {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 60vh;
    }
  }
</style>