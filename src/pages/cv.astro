---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CvTimeline from "../components/CvTimeline.astro";

import { experience } from "../data/experience";
import { projects } from "../data/projects";

const sortedExperience = [...experience].sort(
  (a, b) =>
    new Date(b.startDate).getTime() -
    new Date(a.startDate).getTime()
);
---

<Layout title="CV | Adam Metcalf">
  <main>
    <header class="cv-header">
      <h1>CV</h1>

      <p>
        Professional experience in robotics, systems engineering, software,
        control and multidisciplinary engineering.
      </p>
    </header>

    <div class="cv-body">
      <section class="experience-list">
        {
          sortedExperience.map((job) => {
            const jobProjects = projects.filter(
              (project) =>
                project.display.cv &&
                project.experience?.includes(job.id)
            );

            return (
              <article
                class="experience"
                data-start-year={job.startDate.match(/\d{4}/)?.[0]}
                data-end-year={
                  job.endDate === "Present"
                    ? new Date().getFullYear()
                    : job.endDate.match(/\d{4}/)?.[0]
                }
              >
                <span class="experience-type">
                  {job.type}
                </span>
                <header class="experience-header">
                  <div class="experience-title">
                    <h2>{job.role}</h2>

                    <h3>
                      {
                        job.website ? (
                          <a
                            href={job.website}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {job.organisation}

                            <span
                              class="external-link"
                              aria-hidden="true"
                            >
                              ↗
                            </span>
                          </a>
                        ) : (
                          job.organisation
                        )
                      }
                    </h3>

                    {
                      job.location && (
                        <span class="location">
                          {job.location}
                        </span>
                      )
                    }
                  </div>

                  <div class="dates">
                    {job.startDate} – {job.endDate}
                  </div>
                </header>

                <p class="experience-summary">
                  {job.summary}
                </p>

                {
                  jobProjects.length > 0 && (
                    <div class="experience-projects">
                      <h4>Selected Projects</h4>

                      {
                        jobProjects.map((project) => (
                          <ProjectCard project={project} />
                        ))
                      }
                    </div>
                  )
                }
              </article>
            );
          })
        }
      </section>

      <aside class="timeline-column">
        <CvTimeline />
      </aside>
    </div>
  </main>
</Layout>

<style>
  main {
    width: min(1220px, calc(100% - 3rem));
    margin: auto;
  }

  .cv-header {
    max-width: 800px;

    padding: 7rem 0 6rem;
  }

  .cv-header h1 {
    margin: 0 0 1.5rem;

    font-size: clamp(3.5rem, 9vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .cv-header p {
    max-width: 700px;

    margin: 0;

    color: #555;

    font-size: 1.2rem;
    line-height: 1.7;
  }

  .cv-body {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      6rem;

    gap: 4rem;

    align-items: stretch;
  }

  .experience-list {
    min-width: 0;

    padding-bottom: 8rem;
  }

  .experience {
    border-top: 2px solid #1c1c1c;

    padding: 3rem 0 5rem;
  }

  .experience-header {
    display: flex;

    justify-content: space-between;
    align-items: flex-start;

    gap: 3rem;
  }

  .experience-title {
    min-width: 0;
  }

  .experience-title h2 {
    margin: 0;

    font-size: clamp(1.7rem, 3vw, 2.4rem);
    letter-spacing: -0.02em;
  }

  .experience-title h3 {
    margin: 0.5rem 0 0;

    color: #555;

    font-size: 1.2rem;
    font-weight: 500;
  }

  .experience-title h3 a {
    color: #1c1c1c;

    text-decoration: none;
  }

  .experience-title h3 a:visited {
    color: #1c1c1c;
  }

  .external-link {
    display: inline-block;

    margin-left: 0.35rem;

    font-size: 0.8em;
    font-weight: 400;

    transition: transform 0.15s ease;
  }

  .experience-title h3 a:hover .external-link {
    transform: translate(2px, -2px);
  }

  .location {
    display: block;

    margin-top: 0.4rem;

    color: #777;

    font-size: 0.95rem;
  }

  .dates {
    flex-shrink: 0;

    color: #555;

    font-size: 1rem;
  }

  .experience-summary {
    max-width: 750px;

    margin: 2rem 0 0;

    color: #444;

    font-size: 1.1rem;
    line-height: 1.8;
  }

  .experience-projects {
    max-width: 900px;

    margin-top: 3rem;
  }

  .experience-projects h4 {
    margin: 0 0 1.5rem;

    color: #777;

    font-size: 0.9rem;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .timeline-column {
    position: relative;

    min-width: 0;
  }

  .experience-type {
  display: block;

  margin-bottom: 1.5rem;

  color: #777;

  font-size: 0.8rem;
  font-weight: 600;

  text-transform: uppercase;
  letter-spacing: 0.12em;
}

  @media (max-width: 900px) {
    main {
      width: min(1100px, calc(100% - 3rem));
    }

    .cv-body {
      display: block;
    }

    .timeline-column {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .cv-header {
      padding: 5rem 0 4rem;
    }

    .experience-header {
      flex-direction: column;

      gap: 1rem;
    }

    .experience {
      padding: 2.5rem 0 4rem;
    }
  }
</style>