---
import { experience } from "../data/experience";

const currentYear = new Date().getFullYear();

const years = Array.from(
  new Set(
    experience.flatMap((job) => {
      const startMatch =
        job.startDate.match(/\d{4}/);

      const endMatch =
        job.endDate.match(/\d{4}/);

      const startYear =
        startMatch
          ? Number(startMatch[0])
          : undefined;

      const endYear =
        job.endDate === "Present"
          ? currentYear
          : endMatch
            ? Number(endMatch[0])
            : undefined;

      if (
        startYear === undefined ||
        endYear === undefined
      ) {
        return [];
      }

      const result: number[] = [];

      for (
        let year = startYear;
        year <= endYear;
        year++
      ) {
        result.push(year);
      }

      return result;
    })
  )
).sort((a, b) => b - a);
---

<aside
  class="cv-timeline"
  aria-label="CV timeline"
>
  <div class="timeline">
    {
      years.map((year) => (
        <div
          class="year"
          data-year={year}
        >
          <span class="label">
            {year}
          </span>

          <span class="node"></span>
        </div>
      ))
    }
  </div>
</aside>

<script>
  const experiences =
    document.querySelectorAll<HTMLElement>(
      ".experience[data-start-year]"
    );

  const timelineYears =
    document.querySelectorAll<HTMLElement>(
      ".year[data-year]"
    );

  function clearTimeline() {
    timelineYears.forEach((element) => {
      element.classList.remove("active");
    });
  }

  function activateRange(
    startYear: number,
    endYear: number
  ) {
    clearTimeline();

    timelineYears.forEach((element) => {
      const year =
        Number(element.dataset.year);

      if (
        year >= startYear &&
        year <= endYear
      ) {
        element.classList.add("active");
      }
    });
  }

  const observer =
    new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter(
            (entry) =>
              entry.isIntersecting
          )
          .sort(
            (a, b) =>
              Math.abs(
                a.boundingClientRect.top
              ) -
              Math.abs(
                b.boundingClientRect.top
              )
          );

        const current =
          visible[0]?.target as
            | HTMLElement
            | undefined;

        if (!current) {
          return;
        }

        const startYear =
          Number(
            current.dataset.startYear
          );

        const endYear =
          Number(
            current.dataset.endYear
          );

        activateRange(
          startYear,
          endYear
        );
      },
      {
        rootMargin:
          "-25% 0px -55% 0px",

        threshold: 0,
      }
    );

  experiences.forEach(
    (experience) =>
      observer.observe(experience)
  );
</script>

<style>
  .cv-timeline {
    position: sticky;
    top: 2rem;

    height: calc(100vh - 4rem);

    display: flex;
    align-items: center;
    justify-content: center;

    pointer-events: none;
  }

  .timeline {
    position: relative;

    height: min(80vh, 760px);
    width: 100%;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .timeline::before {
    content: "";

    position: absolute;

    left: 7px;
    top: 8px;
    bottom: 8px;

    width: 2px;

    background: #444;

    z-index: -1;
  }

  .year {
    position: relative;

    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    justify-content: flex-start;

    gap: 0.8rem;

    color: #666;
  }

  .label {
    min-width: 3rem;

    font-size: 0.8rem;
    font-weight: 500;

    transition:
      color 0.2s ease,
      font-weight 0.2s ease;
  }

  .node {
    width: 16px;
    height: 16px;

    flex-shrink: 0;

    border: 3px solid #444;
    border-radius: 50%;

    background: #fafafa;

    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .year.active {
    color: #3f5870;
  }

  .year.active .node {
    border-color: #3f5870;
    background: #3f5870;

    transform: scale(1.15);
  }

  .year.active .label {
    color: #3f5870;

    font-weight: 700;
  }
</style>