<div class="hero-scene" data-home-hero-scene>
  <div class="hero-scene__frame">
    <canvas class="hero-scene__canvas" aria-hidden="true"></canvas>
  </div>
  <div class="hero-scene__caption" aria-live="polite">
    <span class="hero-scene__caption-line hero-scene__caption-line--primary"></span>
    <span class="hero-scene__caption-line hero-scene__caption-line--secondary"></span>
  </div>
</div>

<style>
  .hero-scene {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.9vw, 16px);
  }

  .hero-scene__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    min-height: 460px;
    overflow: hidden;
  }

  .hero-scene__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    background: transparent;
  }

  .hero-scene__caption {
    position: relative;
    width: min(calc(100% - 2rem), 640px);
    min-height: 1.5em;
    text-align: center;
    pointer-events: none;
    font-family: inherit;
    letter-spacing: 0.01em;
  }

  .hero-scene__caption-line {
    display: block;
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    line-height: 1.3;
    color: rgba(17, 19, 24, 0.88);
    text-wrap: balance;
    transition: opacity 180ms linear;
  }

  .hero-scene__caption-line--primary {
    font-weight: 500;
  }

  .hero-scene__caption-line--secondary {
    position: absolute;
    inset: 0;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .hero-scene__frame {
      aspect-ratio: 4 / 3;
      min-height: 340px;
    }
  }
</style>

<script is:inline type="module">
  (() => {
    const root = document.querySelector('[data-home-hero-scene]');
    if (!root) return;

    const frameEl = root.querySelector('.hero-scene__frame');
    const canvas = frameEl.querySelector('canvas');
    const captionPrimary = root.querySelector('.hero-scene__caption-line--primary');
    const captionSecondary = root.querySelector('.hero-scene__caption-line--secondary');
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const DPR_CAP = 3;
    const BLACK = '17, 19, 24';
    const BLUE = '42, 118, 255';
    const PI = Math.PI;

    const ROBOT_SCENE_DURATION = 20.0;
    const BED_SCENE_DURATION = 10.0;
    const ASSEMBLY_SCENE_DURATION = 14.0;
    const SCENE_TRANSITION_DURATION = 2.6;
    const LOOP_DURATION =
      ROBOT_SCENE_DURATION
      + BED_SCENE_DURATION
      + ASSEMBLY_SCENE_DURATION
      + SCENE_TRANSITION_DURATION * 3;

    // Keep inverse-kinematics work below the display refresh rate. Rendering
    // still runs on requestAnimationFrame and interpolates the joint state.
    const SIMULATION_HZ = 30;
    const SIMULATION_DT = 1 / SIMULATION_HZ;
    const IK_ITERATIONS = 3;

    // Heart registration is intentionally slow and deliberate, matching the
    // real impedance-controlled motion rather than a decorative robot demo.
    const MAX_JOINT_SPEED_RAD_S = 0.24;
    const SCANNER_TOOL_LENGTH = 0.17;
    const CONTACT_CLEARANCE = 0.003;
    const PROBE_RETRACT_DISTANCE = 0.075;

    // Canvas particles are rendered in a small number of depth/alpha batches
    // rather than one beginPath()/fill() pair per particle.
    const DEPTH_BUCKETS = 5;
    const ALPHA_BUCKETS = 6;

    const clamp = (v, min = 0, max = 1) => Math.min(max, Math.max(min, v));
    const lerp = (a, b, t) => a + (b - a) * t;
    const smooth = (t) => t * t * (3 - 2 * t);
    const easeInOut = (t) => 0.5 - 0.5 * Math.cos(clamp(t) * PI);
    const pulse = (x, c, w) => Math.exp(-Math.pow((x - c) / w, 2));
    const fract = (x) => x - Math.floor(x);
    const rand2 = (a, b, salt = 0) => fract(Math.sin(a * 127.1 + b * 311.7 + salt * 74.7) * 43758.5453123);

    const vAdd = (a, b) => [a[0] + b[0], a[1] + b[1], a[2] + b[2]];
    const vSub = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
    const vScale = (a, s) => [a[0] * s, a[1] * s, a[2] * s];
    const vLerp = (a, b, t) => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
    const dot = (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
    const cross = (a, b) => [
      a[1] * b[2] - a[2] * b[1],
      a[2] * b[0] - a[0] * b[2],
      a[0] * b[1] - a[1] * b[0],
    ];
    const len = (a) => Math.hypot(a[0], a[1], a[2]);
    const norm = (a) => {
      const l = len(a) || 1;
      return [a[0] / l, a[1] / l, a[2] / l];
    };

    const mm = (A, B) => {
      const r = new Array(9);
      for (let i = 0; i < 3; i++) {
        for (let j = 0; j < 3; j++) {
          r[i * 3 + j] =
            A[i * 3 + 0] * B[0 * 3 + j] +
            A[i * 3 + 1] * B[1 * 3 + j] +
            A[i * 3 + 2] * B[2 * 3 + j];
        }
      }
      return r;
    };

    const mv = (A, v) => [
      A[0] * v[0] + A[1] * v[1] + A[2] * v[2],
      A[3] * v[0] + A[4] * v[1] + A[5] * v[2],
      A[6] * v[0] + A[7] * v[1] + A[8] * v[2],
    ];

    const rpy = (r, p, y) => {
      const cr = Math.cos(r), sr = Math.sin(r);
      const cp = Math.cos(p), sp = Math.sin(p);
      const cy = Math.cos(y), sy = Math.sin(y);
      return [
        cy * cp,
        cy * sp * sr - sy * cr,
        cy * sp * cr + sy * sr,
        sy * cp,
        sy * sp * sr + cy * cr,
        sy * sp * cr - cy * sr,
        -sp,
        cp * sr,
        cp * cr,
      ];
    };

    const rotZ = (q) => {
      const c = Math.cos(q);
      const s = Math.sin(q);
      return [c, -s, 0, s, c, 0, 0, 0, 1];
    };

    const IDENTITY = [1, 0, 0, 0, 1, 0, 0, 0, 1];

    const JOINTS = [
      { offset: [0, 0, 0.1575], rpy: [0, 0, 0], limit: (170 * PI) / 180 },
      { offset: [0, 0, 0.2025], rpy: [PI / 2, 0, PI], limit: (120 * PI) / 180 },
      { offset: [0, 0.2045, 0], rpy: [PI / 2, 0, PI], limit: (170 * PI) / 180 },
      { offset: [0, 0, 0.2155], rpy: [PI / 2, 0, 0], limit: (120 * PI) / 180 },
      { offset: [0, 0.1845, 0], rpy: [-PI / 2, PI, 0], limit: (170 * PI) / 180 },
      { offset: [0, 0, 0.2155], rpy: [PI / 2, 0, 0], limit: (120 * PI) / 180 },
      { offset: [0, 0.081, 0], rpy: [-PI / 2, PI, 0], limit: (175 * PI) / 180 },
    ];

    const JOINT_ROT = JOINTS.map((joint) => rpy(...joint.rpy));
    const BASE_ROT = [1, 0, 0, 0, 0, 1, 0, -1, 0];
    const REST_Q = [0, 0.55, 0, -1.35, 0, 0.9, 0];

    function fk(q, base = [0, 0, 0]) {
      let R = BASE_ROT.slice();
      let t = base.slice();
      const frames = [{ R, t }];

      for (let i = 0; i < JOINTS.length; i++) {
        t = vAdd(t, mv(R, JOINTS[i].offset));
        R = mm(mm(R, JOINT_ROT[i]), rotZ(q[i]));
        frames.push({ R, t });
      }

      const flange = {
        R,
        t: vAdd(t, mv(R, [0, 0, 0.045])),
      };

      return { frames, flange };
    }

    function solveLinear6(A, b) {
      const n = 6;
      const M = A.map((row, i) => row.concat([b[i]]));

      for (let c = 0; c < n; c++) {
        let pivot = c;
        for (let r = c + 1; r < n; r++) {
          if (Math.abs(M[r][c]) > Math.abs(M[pivot][c])) pivot = r;
        }
        [M[c], M[pivot]] = [M[pivot], M[c]];
        const d = M[c][c] || 1e-6;
        for (let r = 0; r < n; r++) {
          if (r === c) continue;
          const f = M[r][c] / d;
          for (let k = c; k <= n; k++) M[r][k] -= f * M[c][k];
        }
      }

      return M.map((row, i) => row[n] / (row[i] || 1e-6));
    }

    function solveIK(q, targetPosition, targetDirection, base, iterations = 3) {
      const errorFor = (qq) => {
        const { flange } = fk(qq, base);
        const toolZ = [flange.R[2], flange.R[5], flange.R[8]];
        const posError = vSub(targetPosition, flange.t);
        const dirError = vScale(vSub(targetDirection, toolZ), 0.8);
        return [
          posError[0], posError[1], posError[2],
          dirError[0], dirError[1], dirError[2],
        ];
      };

      for (let iter = 0; iter < iterations; iter++) {
        const e = errorFor(q);
        const J = [];
        const h = 1e-3;

        for (let j = 0; j < JOINTS.length; j++) {
          const q2 = q.slice();
          q2[j] += h;
          const e2 = errorFor(q2);
          J.push(e2.map((value, i) => (value - e[i]) / h));
        }

        const A = [];
        const lambda = 0.14;
        for (let r = 0; r < 6; r++) {
          A.push([]);
          for (let c = 0; c < 6; c++) {
            let sum = 0;
            for (let j = 0; j < JOINTS.length; j++) sum += J[j][r] * J[j][c];
            A[r].push(sum + (r === c ? lambda * lambda : 0));
          }
        }

        const y = solveLinear6(A, e);
        for (let j = 0; j < JOINTS.length; j++) {
          let step = 0;
          for (let r = 0; r < 6; r++) step += J[j][r] * y[r];
          q[j] = clamp(
            q[j] + clamp(-step + 0.02 * (REST_Q[j] - q[j]), -0.12, 0.12),
            -JOINTS[j].limit * 0.9,
            JOINTS[j].limit * 0.9,
          );
        }
      }

      return q;
    }


    function solveProbeTipIK(q, targetTipPosition, targetDirection, base, iterations = 5) {
      const errorFor = (qq) => {
        const { flange } = fk(qq, base);
        const toolZ = [flange.R[2], flange.R[5], flange.R[8]];
        const tipPosition = vAdd(
          flange.t,
          vScale(toolZ, SCANNER_TOOL_LENGTH),
        );

        const posError = vSub(targetTipPosition, tipPosition);

        // Keep a weak downward-orientation preference, but prioritise the tip
        // position so the probe actually reaches the specimen.
        const dirError = vScale(vSub(targetDirection, toolZ), 0.03);

        return [
          posError[0], posError[1], posError[2],
          dirError[0], dirError[1], dirError[2],
        ];
      };

      for (let iter = 0; iter < iterations; iter++) {
        const e = errorFor(q);
        const J = [];
        const h = 1e-3;

        for (let j = 0; j < JOINTS.length; j++) {
          const q2 = q.slice();
          q2[j] += h;
          const e2 = errorFor(q2);
          J.push(e2.map((value, i) => (value - e[i]) / h));
        }

        const A = [];
        const lambda = 0.08;
        for (let r = 0; r < 6; r++) {
          A.push([]);
          for (let c = 0; c < 6; c++) {
            let sum = 0;
            for (let j = 0; j < JOINTS.length; j++) sum += J[j][r] * J[j][c];
            A[r].push(sum + (r === c ? lambda * lambda : 0));
          }
        }

        const y = solveLinear6(A, e);
        for (let j = 0; j < JOINTS.length; j++) {
          let step = 0;
          for (let r = 0; r < 6; r++) step += J[j][r] * y[r];

          q[j] = clamp(
            q[j] + clamp(-step + 0.01 * (REST_Q[j] - q[j]), -0.12, 0.12),
            -JOINTS[j].limit * 0.9,
            JOINTS[j].limit * 0.9,
          );
        }
      }

      return q;
    }

    function buildCylinder(start, end, radius, rings = 12, around = 18, capDensity = 6) {
      const axis = vSub(end, start);
      const w = norm(axis);
      const tmp = Math.abs(w[1]) > 0.9 ? [1, 0, 0] : [0, 1, 0];
      const u = norm(cross(w, tmp));
      const v = cross(w, u);
      const points = [];

      for (let i = 0; i <= rings; i++) {
        const t = i / rings;
        const center = vAdd(start, vScale(axis, t));
        for (let j = 0; j < around; j++) {
          const a = (j / around) * PI * 2 + (i % 2) * (PI / around);
          const normal = vAdd(vScale(u, Math.cos(a)), vScale(v, Math.sin(a)));
          points.push({ p: vAdd(center, vScale(normal, radius)), n: normal });
        }
      }

      for (const endCap of [0, 1]) {
        const capCenter = endCap === 0 ? start : end;
        const normal = endCap === 0 ? vScale(w, -1) : w;
        for (let r = 0; r <= capDensity; r++) {
          const rr = radius * (r / capDensity);
          const count = Math.max(6, Math.round(around * Math.max(rr / radius, 0.2)));
          for (let j = 0; j < count; j++) {
            const a = (j / count) * PI * 2;
            const radial = vAdd(vScale(u, Math.cos(a)), vScale(v, Math.sin(a)));
            points.push({ p: vAdd(capCenter, vScale(radial, rr)), n: normal });
          }
        }
      }

      return points;
    }

    function buildSphere(center, radius, latSteps = 9, lonSteps = 16) {
      const points = [];
      for (let i = 1; i < latSteps; i++) {
        const phi = (i / latSteps) * PI;
        const sp = Math.sin(phi);
        const cp = Math.cos(phi);
        for (let j = 0; j < lonSteps; j++) {
          const theta = (j / lonSteps) * PI * 2;
          const normal = [Math.cos(theta) * sp, cp, Math.sin(theta) * sp];
          points.push({ p: vAdd(center, vScale(normal, radius)), n: normal });
        }
      }
      return points;
    }

    function buildBox(center, sx, sy, sz, nx = 10, ny = 4, nz = 8) {
      const [cx, cy, cz] = center;
      const x0 = cx - sx / 2, x1 = cx + sx / 2;
      const y0 = cy - sy / 2, y1 = cy + sy / 2;
      const z0 = cz - sz / 2, z1 = cz + sz / 2;
      const points = [];

      for (let ix = 0; ix <= nx; ix++) {
        const x = lerp(x0, x1, ix / nx);
        for (let iz = 0; iz <= nz; iz++) {
          const z = lerp(z0, z1, iz / nz);
          points.push({ p: [x, y1, z], n: [0, 1, 0] });
          points.push({ p: [x, y0, z], n: [0, -1, 0] });
        }
      }

      for (let ix = 0; ix <= nx; ix++) {
        const x = lerp(x0, x1, ix / nx);
        for (let iy = 0; iy <= ny; iy++) {
          const y = lerp(y0, y1, iy / ny);
          points.push({ p: [x, y, z1], n: [0, 0, 1] });
          points.push({ p: [x, y, z0], n: [0, 0, -1] });
        }
      }

      for (let iz = 0; iz <= nz; iz++) {
        const z = lerp(z0, z1, iz / nz);
        for (let iy = 0; iy <= ny; iy++) {
          const y = lerp(y0, y1, iy / ny);
          points.push({ p: [x1, y, z], n: [1, 0, 0] });
          points.push({ p: [x0, y, z], n: [-1, 0, 0] });
        }
      }

      return points;
    }

    function decimate(points, stride = 2, offset = 0) {
      return points.filter((_, index) => ((index + offset) % stride) === 0);
    }

    const ASSEMBLY_SCENE_DENSITY = 3.55;

    function buildLineCloudXZ(a, b, y = 0.02, spacing = 0.014) {
      const dx = b[0] - a[0];
      const dz = b[1] - a[1];
      const distance = Math.hypot(dx, dz);
      const count = Math.max(2, Math.ceil((distance / spacing) * ASSEMBLY_SCENE_DENSITY));
      const points = [];
      for (let i = 0; i <= count; i++) {
        const t = i / count;
        points.push({
          p: [lerp(a[0], b[0], t), y, lerp(a[1], b[1], t)],
          n: [0, 1, 0],
        });
      }
      return points;
    }

    function buildPolylineCloudXZ(vertices, y = 0.02, spacing = 0.014) {
      const points = [];
      for (let i = 0; i < vertices.length - 1; i++) {
        points.push(...buildLineCloudXZ(vertices[i], vertices[i + 1], y, spacing));
      }
      return points;
    }

    function buildCircleCloudXZ(center, radius, y = 0.02, count = 56) {
      const points = [];
      for (let i = 0; i < count; i++) {
        const a = (i / count) * PI * 2;
        points.push({
          p: [center[0] + Math.cos(a) * radius, y, center[1] + Math.sin(a) * radius],
          n: [0, 1, 0],
        });
      }
      return points;
    }

    function buildRectOutlineCloudXZ(center, sx, sz, y = 0.02, spacing = 0.014) {
      const x0 = center[0] - sx / 2;
      const x1 = center[0] + sx / 2;
      const z0 = center[1] - sz / 2;
      const z1 = center[1] + sz / 2;
      return buildPolylineCloudXZ([
        [x0, z0], [x1, z0], [x1, z1], [x0, z1], [x0, z0],
      ], y, spacing);
    }

    function buildResistorCloudXZ(start, end, y = 0.02) {
      const dx = end[0] - start[0];
      const dz = end[1] - start[1];
      const L = Math.hypot(dx, dz) || 1;
      const ux = dx / L, uz = dz / L;
      const px = -uz, pz = ux;
      const verts = [start];
      const zigCount = 7;
      for (let i = 1; i < zigCount; i++) {
        const t = i / zigCount;
        const a = (i % 2 ? 1 : -1) * 0.035;
        verts.push([
          start[0] + dx * t + px * a,
          start[1] + dz * t + pz * a,
        ]);
      }
      verts.push(end);
      return buildPolylineCloudXZ(verts, y, 0.011);
    }

    function resampleCloud(cloud, count) {
      if (!cloud.length || count <= 0) return [];
      const points = [];
      for (let i = 0; i < count; i++) {
        const idx = Math.floor((i / count) * cloud.length) % cloud.length;
        points.push(cloud[idx]);
      }
      return points;
    }

    function densifyCloud(cloud, factor = ASSEMBLY_SCENE_DENSITY) {
      return resampleCloud(cloud, Math.max(1, Math.round(cloud.length * factor)));
    }

    function scaleCloudXZ(cloud, sx = 1, sz = sx, center = [0, 0]) {
      return cloud.map((pt) => ({
        p: [
          center[0] + (pt.p[0] - center[0]) * sx,
          pt.p[1],
          center[1] + (pt.p[2] - center[1]) * sz,
        ],
        n: pt.n,
      }));
    }

    const LINK_POINT_CLOUDS = [
      [
        ...buildCylinder([0, 0, -0.09], [0, 0, -0.05], 0.135, 6, 16, 4),
        ...buildCylinder([0, 0, -0.05], [0, 0, 0.1], 0.108, 10, 14, 4),
        ...buildCylinder([0, 0, 0.1], [0, 0, 0.1575], 0.085, 6, 12, 4),
      ],
      decimate([
        ...buildSphere([0, 0, 0], 0.07, 8, 14),
        ...buildCylinder([0, 0, 0.025], [0, 0, 0.2025], 0.06, 10, 14, 4),
      ], 2, 1),
      decimate([
        ...buildSphere([0, 0, 0], 0.065, 8, 14),
        ...buildCylinder([0, 0, 0], [0, 0.2045, 0], 0.055, 10, 14, 4),
      ], 2),
      decimate([
        ...buildSphere([0, 0, 0], 0.06, 8, 14),
        ...buildCylinder([0, 0, 0.01], [0, 0, 0.2155], 0.05, 10, 14, 4),
      ], 2, 1),
      decimate([
        ...buildSphere([0, 0, 0], 0.055, 7, 13),
        ...buildCylinder([0, 0, 0], [0, 0.1845, 0], 0.045, 9, 12, 4),
      ], 2),
      decimate([
        ...buildSphere([0, 0, 0], 0.05, 7, 12),
        ...buildCylinder([0, 0, 0], [0, 0, 0.2155], 0.04, 9, 12, 4),
      ], 2, 1),
      decimate([
        ...buildSphere([0, 0, 0], 0.045, 6, 11),
        ...buildCylinder([0, 0, 0], [0, 0.081, 0], 0.037, 7, 11, 3),
      ], 2),
    ];

    const FLANGE_POINT_CLOUD = decimate([
      ...buildCylinder([0, 0, -0.012], [0, 0, 0.018], 0.04, 6, 12, 3),
      ...buildCylinder([0, 0, 0.018], [0, 0, 0.03], 0.022, 4, 10, 3),
    ], 2);

    const FLANGE_POINT_CLOUD_DENSE = [
      ...buildCylinder([0, 0, -0.012], [0, 0, 0.018], 0.04, 10, 18, 4),
      ...buildCylinder([0, 0, 0.018], [0, 0, 0.03], 0.022, 7, 14, 4),
    ];


    // ---------------------------------------------------------------------
    // HEART SURFACE REGISTRATION SCENE
    // ---------------------------------------------------------------------
    // A compact height-field heart model. It is deliberately stylised rather
    // than anatomical CAD: the visual cue is the important part here — an
    // iiwa probing a curved tissue surface, aligning to the local normal and
    // leaving registered surface/normal samples behind.
    const HEART_CENTER = [0.34, 0.02925, 0.14];
    const HEART_SCALE_X = 0.056;
    const HEART_SCALE_Z = 0.051;
    const HEART_BASE_Y = 0.035;

    function heartOutline(theta) {
      const s = Math.sin(theta);
      const x = (16 * s * s * s) / 16;
      const z = (
        13 * Math.cos(theta)
        - 5 * Math.cos(2 * theta)
        - 2 * Math.cos(3 * theta)
        - Math.cos(4 * theta)
      ) / 17;
      return [x, z];
    }

    function heartSurfacePoint(theta, radial) {
      const [ox, oz] = heartOutline(theta);
      const r = clamp(radial, 0.04, 1);
      const x = HEART_CENTER[0] + HEART_SCALE_X * ox * r;
      const z = HEART_CENTER[2] + HEART_SCALE_Z * oz * r;

      // Convex tissue surface with a mild central groove and asymmetric
      // anatomical-looking undulation.
      const dome = 0.055 * Math.pow(Math.max(0, 1 - r * r), 0.62);
      const groove = -0.010 * Math.exp(-Math.pow((x - HEART_CENTER[0]) / 0.025, 2))
        * (0.35 + 0.65 * r);
      const texture =
        0.0045 * Math.sin(theta * 3.0 + r * 2.2)
        + 0.0035 * Math.cos(theta * 2.0 - r * 4.0);

      return [
        x,
        HEART_CENTER[1] + HEART_BASE_Y + dome + groove + texture,
        z,
      ];
    }

    function heartSurfaceNormal(theta, radial) {
      const h = 1e-3;
      const pThetaA = heartSurfacePoint(theta - h, radial);
      const pThetaB = heartSurfacePoint(theta + h, radial);
      const pRadialA = heartSurfacePoint(theta, Math.max(0.04, radial - h));
      const pRadialB = heartSurfacePoint(theta, Math.min(1, radial + h));

      const tangentTheta = vSub(pThetaB, pThetaA);
      const tangentRadial = vSub(pRadialB, pRadialA);
      let n = norm(cross(tangentRadial, tangentTheta));
      if (n[1] < 0) n = vScale(n, -1);
      return n;
    }

    function buildHeartSurface(radialSteps = 12, around = 34) {
      const points = [];

      for (let ri = 1; ri <= radialSteps; ri++) {
        const radial = ri / radialSteps;
        const count = Math.max(12, Math.round(around * (0.35 + 0.65 * radial)));

        for (let ti = 0; ti < count; ti++) {
          const theta = (ti / count) * PI * 2 + (ri % 2) * (PI / count);
          points.push({
            p: heartSurfacePoint(theta, radial),
            n: heartSurfaceNormal(theta, radial),
          });
        }
      }

      // A sparse lower rim gives the point cloud some visible thickness.
      for (let ti = 0; ti < around; ti++) {
        const theta = (ti / around) * PI * 2;
        const top = heartSurfacePoint(theta, 1);
        const outward = heartSurfaceNormal(theta, 1);
        for (let layer = 1; layer <= 3; layer++) {
          points.push({
            p: [top[0], top[1] - layer * 0.028, top[2]],
            n: outward,
          });
        }
      }

      return points;
    }

    const HEART_SURFACE_CLOUD = buildHeartSurface(16, 46);
    const HEART_SURFACE_CLOUD_DENSE = buildHeartSurface(36, 102);

    const HEART_TRAY_CLOUD = decimate(
      buildBox([HEART_CENTER[0], HEART_CENTER[1] - 0.012, HEART_CENTER[2]], 0.171, 0.020, 0.152, 8, 2, 7),
      3,
    );

    // Simple probe visual mounted along flange tool-Z. The exact experimental
    // end-effector is intentionally abstracted; the contact behaviour matters
    // more than reproducing every bracket and sensor.
    const SCANNER_POINT_CLOUD = decimate([
      ...buildCylinder([0, 0, 0.025], [0, 0, 0.095], 0.022, 5, 12, 2),
      ...buildCylinder([0, 0, 0.095], [0, 0, 0.145], 0.010, 4, 10, 2),
      ...buildCylinder([0, 0, 0.145], [0, 0, 0.17], 0.0045, 3, 9, 1),
    ], 2);

    const SCANNER_POINT_CLOUD_DENSE = [
      ...buildCylinder([0, 0, 0.025], [0, 0, 0.095], 0.022, 10, 20, 3),
      ...buildCylinder([0, 0, 0.095], [0, 0, 0.145], 0.010, 8, 18, 3),
      ...buildCylinder([0, 0, 0.145], [0, 0, 0.17], 0.0045, 6, 14, 2),
    ];

    // Probe ordering is intentionally spatially coherent so the arm traverses
    // the surface rather than jumping around it.
    // A single scene now registers only a handful of nearby locations. The
    // real system moves cautiously between contacts; trying to visit fourteen
    // points in a few seconds made the simulated arm look unnaturally frantic.
    const HEART_PROBE_UV = [
      [0.10, 0.28],
      [0.18, 0.36],
      [0.27, 0.44],
      [0.37, 0.38],
      [0.48, 0.30],
      [0.58, 0.36],
    ];

    const HEART_PROBES = HEART_PROBE_UV.map(([u, radial]) => {
      const theta = u * PI * 2;
      return {
        p: heartSurfacePoint(theta, radial),
        n: heartSurfaceNormal(theta, radial),
      };
    });

    const PCB_BOARD_CLOUD = buildBox([0, 0, 0], 1.45, 0.03, 1.0, 30, 5, 24);

    const PCB_COMPONENT_CLOUDS = [
      buildBox([0.0, 0.052, 0.02], 0.38, 0.085, 0.26, 10, 4, 8),
      buildBox([-0.48, 0.048, -0.3], 0.18, 0.065, 0.14, 7, 3, 6),
      buildBox([-0.25, 0.045, -0.34], 0.12, 0.05, 0.08, 5, 3, 4),
      buildBox([0.44, 0.048, -0.28], 0.2, 0.065, 0.14, 8, 3, 6),
      buildBox([0.22, 0.046, -0.38], 0.16, 0.05, 0.08, 6, 3, 4),
      buildBox([-0.48, 0.045, 0.28], 0.22, 0.055, 0.13, 8, 3, 5),
      buildBox([0.47, 0.05, 0.28], 0.24, 0.06, 0.14, 8, 3, 6),
      buildBox([-0.12, 0.043, 0.34], 0.18, 0.05, 0.08, 6, 3, 4),
      buildBox([0.17, 0.043, 0.34], 0.18, 0.05, 0.08, 6, 3, 4),
      buildBox([-0.58, 0.042, 0.0], 0.12, 0.045, 0.18, 5, 3, 6),
      buildBox([0.6, 0.042, 0.02], 0.12, 0.045, 0.18, 5, 3, 6),
      buildBox([0.0, 0.042, -0.42], 0.24, 0.045, 0.08, 7, 3, 4),
    ].map((cloud, i) => decimate(cloud, 2 + (i % 3 === 0 ? 1 : 0), i % 2));

    const PCB_DETAIL_CLOUDS = [];
    // Connector / header rows
    for (let i = 0; i < 8; i++) {
      PCB_DETAIL_CLOUDS.push(decimate(buildBox([-0.69 + i * 0.05, 0.036, -0.46], 0.03, 0.03, 0.04, 3, 2, 3), 1));
      PCB_DETAIL_CLOUDS.push(decimate(buildBox([-0.69 + i * 0.05, 0.036, 0.46], 0.03, 0.03, 0.04, 3, 2, 3), 1));
    }
    // Passive components rows
    for (let i = 0; i < 6; i++) {
      PCB_DETAIL_CLOUDS.push(decimate(buildBox([-0.52 + i * 0.18, 0.035, -0.14], 0.06, 0.028, 0.03, 4, 2, 2), 1));
      PCB_DETAIL_CLOUDS.push(decimate(buildBox([-0.49 + i * 0.17, 0.035, 0.18], 0.055, 0.028, 0.03, 4, 2, 2), 1));
    }
    // Low-profile traces / buses
    for (const trace of [
      [-0.28, 0.018, 0.0, 0.66, 0.006, 0.025],
      [0.22, 0.018, 0.11, 0.56, 0.006, 0.025],
      [0.0, 0.018, -0.24, 0.72, 0.006, 0.025],
      [-0.56, 0.018, 0.04, 0.025, 0.006, 0.46],
      [0.56, 0.018, -0.03, 0.025, 0.006, 0.42],
      [0.0, 0.018, 0.4, 0.9, 0.006, 0.02],
      [0.0, 0.018, -0.4, 0.9, 0.006, 0.02],
    ]) {
      PCB_DETAIL_CLOUDS.push(decimate(buildBox([trace[0], trace[1], trace[2]], trace[3], trace[4], trace[5], 10, 1, 3), 2));
    }


    // ---------------------------------------------------------------------
    // IMPROVED WIEN BRIDGE OSCILLATOR -> PCB -> POPULATED PCB SCENE
    // ---------------------------------------------------------------------
    // Based on the actual KiCad/LTspice circuit used for the bioimpedance
    // generator: ADA4625-2ARDZ, R1/R5 = 1.6 kOhm, C1/C2 = 1 nF,
    // R2 = 470 Ohm, R3/R4 = 10 kOhm, R6 = 16 kOhm, R7 = 4.7 kOhm,
    // D1/D2 = 1N914, C3 = 1 nF and a four-way +/-5 V / AGND / Vout header.

    function buildCapacitorCloudXZ(start, end, y = 0.02) {
      const dx = end[0] - start[0];
      const dz = end[1] - start[1];
      const L = Math.hypot(dx, dz) || 1;
      const ux = dx / L, uz = dz / L;
      const px = -uz, pz = ux;
      const mid = [(start[0] + end[0]) * 0.5, (start[1] + end[1]) * 0.5];
      const gap = Math.min(0.025, L * 0.14);
      const plateHalf = 0.050;
      const plateA = [mid[0] - ux * gap, mid[1] - uz * gap];
      const plateB = [mid[0] + ux * gap, mid[1] + uz * gap];
      return [
        ...buildLineCloudXZ(start, plateA, y, 0.010),
        ...buildLineCloudXZ(end, plateB, y, 0.010),
        ...buildLineCloudXZ(
          [plateA[0] - px * plateHalf, plateA[1] - pz * plateHalf],
          [plateA[0] + px * plateHalf, plateA[1] + pz * plateHalf],
          y,
          0.009,
        ),
        ...buildLineCloudXZ(
          [plateB[0] - px * plateHalf, plateB[1] - pz * plateHalf],
          [plateB[0] + px * plateHalf, plateB[1] + pz * plateHalf],
          y,
          0.009,
        ),
      ];
    }

    function buildDiodeCloudXZ(start, end, reversed = false, y = 0.02) {
      const a = reversed ? end : start;
      const b = reversed ? start : end;
      const dx = b[0] - a[0];
      const dz = b[1] - a[1];
      const L = Math.hypot(dx, dz) || 1;
      const ux = dx / L, uz = dz / L;
      const px = -uz, pz = ux;
      const c = [(a[0] + b[0]) * 0.5, (a[1] + b[1]) * 0.5];
      const left = [c[0] - ux * 0.045, c[1] - uz * 0.045];
      const tip = [c[0] + ux * 0.015, c[1] + uz * 0.015];
      const bar = [c[0] + ux * 0.040, c[1] + uz * 0.040];
      return [
        ...buildLineCloudXZ(start, reversed ? bar : left, y, 0.010),
        ...buildLineCloudXZ(end, reversed ? left : bar, y, 0.010),
        ...buildLineCloudXZ(
          [left[0] + px * 0.035, left[1] + pz * 0.035],
          tip,
          y,
          0.008,
        ),
        ...buildLineCloudXZ(
          [left[0] - px * 0.035, left[1] - pz * 0.035],
          tip,
          y,
          0.008,
        ),
        ...buildLineCloudXZ(
          [bar[0] + px * 0.043, bar[1] + pz * 0.043],
          [bar[0] - px * 0.043, bar[1] - pz * 0.043],
          y,
          0.008,
        ),
      ];
    }

    function buildOpAmpCloudXZ(center, sx = 0.26, sz = 0.22, y = 0.02) {
      const [cx, cz] = center;
      const x0 = cx - sx * 0.5;
      const x1 = cx + sx * 0.5;
      return [
        ...buildPolylineCloudXZ([
          [x0, cz - sz * 0.5],
          [x0, cz + sz * 0.5],
          [x1, cz],
          [x0, cz - sz * 0.5],
        ], y, 0.010),
        ...buildLineCloudXZ([x0 - 0.070, cz - sz * 0.23], [x0, cz - sz * 0.23], y, 0.010),
        ...buildLineCloudXZ([x0 - 0.070, cz + sz * 0.23], [x0, cz + sz * 0.23], y, 0.010),
        ...buildLineCloudXZ([x1, cz], [x1 + 0.075, cz], y, 0.010),
      ];
    }

    function getOpAmpPinsXZ(center, sx = 0.26, sz = 0.22) {
      const [cx, cz] = center;
      const x0 = cx - sx * 0.5;
      const x1 = cx + sx * 0.5;
      return {
        upper: [x0 - 0.070, cz - sz * 0.23],
        lower: [x0 - 0.070, cz + sz * 0.23],
        out: [x1 + 0.075, cz],
      };
    }

    function buildJunctionCloudXZ(x, z, y = 0.021, radius = 0.018) {
      return buildCircleCloudXZ([x, z], radius, y, 18);
    }

    function buildGroundCloudXZ(x, z, y = 0.02) {
      return [
        ...buildLineCloudXZ([x, z], [x, z + 0.035], y, 0.009),
        ...buildLineCloudXZ([x - 0.045, z + 0.035], [x + 0.045, z + 0.035], y, 0.009),
        ...buildLineCloudXZ([x - 0.030, z + 0.055], [x + 0.030, z + 0.055], y, 0.009),
        ...buildLineCloudXZ([x - 0.015, z + 0.075], [x + 0.015, z + 0.075], y, 0.009),
      ];
    }

    const SCHEMATIC_CLOUD = (() => {
      const c = [];

      // The oscillator is laid out from explicit electrical nodes. This keeps
      // every symbol endpoint coincident with its corresponding wire endpoint
      // and avoids visual near-misses after perspective projection.
      const U1A_CENTER = [-0.56, 0.00];
      const U1B_CENTER = [0.78, 0.0506];
      const U1_SX = 0.26;
      const U1_SZ = 0.22;
      const u1a = getOpAmpPinsXZ(U1A_CENTER, U1_SX, U1_SZ);
      const u1b = getOpAmpPinsXZ(U1B_CENTER, U1_SX, U1_SZ);

      const VOUT_X = 1.34;
      const VOUT_Z = u1b.out[1];
      const FEEDBACK_Z = 0.46;

      c.push(...buildOpAmpCloudXZ(U1A_CENTER, U1_SX, U1_SZ));
      c.push(...buildOpAmpCloudXZ(U1B_CENTER, U1_SX, U1_SZ));

      // -----------------------------------------------------------------
      // Wien bridge into U1A non-inverting input.
      // -----------------------------------------------------------------
      const wienNode = [-1.02, u1a.upper[1]];
      c.push(...buildLineCloudXZ(wienNode, u1a.upper));
      c.push(...buildJunctionCloudXZ(...wienNode));

      // R1 and C1 are parallel from the Wien node to AGND.
      const r1x = -1.28;
      const c1x = -0.86;
      const shuntTopZ = 0.08;
      const shuntBottomZ = 0.30;
      const shuntBusZ = 0.50;

      c.push(...buildPolylineCloudXZ([wienNode, [r1x, wienNode[1]], [r1x, shuntTopZ]]));
      c.push(...buildResistorCloudXZ([r1x, shuntTopZ], [r1x, shuntBottomZ])); // R1 1.6k
      c.push(...buildLineCloudXZ([r1x, shuntBottomZ], [r1x, shuntBusZ]));

      c.push(...buildPolylineCloudXZ([wienNode, [c1x, wienNode[1]], [c1x, shuntTopZ]]));
      c.push(...buildCapacitorCloudXZ([c1x, shuntTopZ], [c1x, shuntBottomZ])); // C1 1nF
      c.push(...buildLineCloudXZ([c1x, shuntBottomZ], [c1x, shuntBusZ]));

      c.push(...buildLineCloudXZ([r1x, shuntBusZ], [c1x, shuntBusZ]));
      c.push(...buildJunctionCloudXZ(r1x, shuntBusZ));
      c.push(...buildJunctionCloudXZ(c1x, shuntBusZ));
      c.push(...buildGroundCloudXZ((r1x + c1x) * 0.5, shuntBusZ));

      // Vout -> C2/R5 series arm -> Wien node.
      const topZ = -0.60;
      c.push(...buildLineCloudXZ(wienNode, [wienNode[0], topZ]));
      c.push(...buildResistorCloudXZ([wienNode[0], topZ], [-0.46, topZ])); // R5 1.6k
      c.push(...buildLineCloudXZ([-0.46, topZ], [-0.34, topZ]));
      c.push(...buildCapacitorCloudXZ([-0.34, topZ], [-0.04, topZ])); // C2 1nF
      c.push(...buildLineCloudXZ([-0.04, topZ], [1.48, topZ]));
      c.push(...buildLineCloudXZ([1.48, topZ], [1.48, VOUT_Z]));
      c.push(...buildLineCloudXZ([1.48, VOUT_Z], [VOUT_X, VOUT_Z]));

      // -----------------------------------------------------------------
      // U1A output -> R2 -> U1B non-inverting input.
      // U1B is vertically offset very slightly so this signal path is a clean
      // horizontal net rather than a diagonal/near-miss at the pin.
      // -----------------------------------------------------------------
      const r2Left = [-0.18, u1a.out[1]];
      const r2Right = [0.12, u1a.out[1]];
      c.push(...buildLineCloudXZ(u1a.out, r2Left));
      c.push(...buildResistorCloudXZ(r2Left, r2Right)); // R2 470
      c.push(...buildLineCloudXZ(r2Right, [u1b.upper[0], r2Right[1]]));
      c.push(...buildLineCloudXZ([u1b.upper[0], r2Right[1]], u1b.upper));

      // R4 shunts the R2/U1B+ node to AGND.
      const r4Node = [0.18, u1a.out[1]];
      c.push(...buildJunctionCloudXZ(...r4Node));
      c.push(...buildLineCloudXZ(r4Node, [r4Node[0], 0.16]));
      c.push(...buildResistorCloudXZ([r4Node[0], 0.16], [r4Node[0], 0.31])); // R4 10k
      c.push(...buildLineCloudXZ([r4Node[0], 0.31], [r4Node[0], 0.35]));
      c.push(...buildGroundCloudXZ(r4Node[0], 0.35));

      // U1B is a follower: its inverting input returns directly to Vout.
      c.push(...buildLineCloudXZ(u1b.out, [VOUT_X, VOUT_Z]));
      c.push(...buildJunctionCloudXZ(VOUT_X, VOUT_Z));
      c.push(...buildPolylineCloudXZ([
        u1b.lower,
        [1.02, u1b.lower[1]],
        [1.02, VOUT_Z],
        [VOUT_X, VOUT_Z],
      ]));

      // -----------------------------------------------------------------
      // U1A inverting path and amplitude-control network.
      // -----------------------------------------------------------------
      const invBusX = -0.98;
      const invPinNode = [invBusX, u1a.lower[1]];
      c.push(...buildLineCloudXZ(u1a.lower, invPinNode));
      c.push(...buildLineCloudXZ(invPinNode, [invBusX, FEEDBACK_Z]));

      // R3 branches from the U1A inverting net to AGND.
      const r3BranchZ = 0.17;
      const r3x = -1.26;
      c.push(...buildJunctionCloudXZ(invBusX, r3BranchZ));
      c.push(...buildLineCloudXZ([invBusX, r3BranchZ], [r3x, r3BranchZ]));
      c.push(...buildResistorCloudXZ([r3x, r3BranchZ], [r3x, 0.32])); // R3 10k
      c.push(...buildLineCloudXZ([r3x, 0.32], [r3x, 0.35]));
      c.push(...buildGroundCloudXZ(r3x, 0.35));

      // R6 then R7 return the inverting path to Vout.
      const r6Left = [-0.74, FEEDBACK_Z];
      const r6Right = [-0.22, FEEDBACK_Z];
      const r7Left = [0.28, FEEDBACK_Z];
      const r7Right = [0.82, FEEDBACK_Z];

      c.push(...buildLineCloudXZ([invBusX, FEEDBACK_Z], r6Left));
      c.push(...buildResistorCloudXZ(r6Left, r6Right)); // R6 16k
      c.push(...buildLineCloudXZ(r6Right, r7Left));
      c.push(...buildJunctionCloudXZ(...r7Left));
      c.push(...buildResistorCloudXZ(r7Left, r7Right)); // R7 4.7k
      c.push(...buildJunctionCloudXZ(...r7Right));
      c.push(...buildLineCloudXZ(r7Right, [VOUT_X, FEEDBACK_Z]));
      c.push(...buildLineCloudXZ([VOUT_X, FEEDBACK_Z], [VOUT_X, VOUT_Z]));

      // D1/D2 are antiparallel across R7. Give them generous separation so
      // the two diode symbols remain distinct at all viewport sizes.
      const diodeTopZ = 0.66;
      const diodeBottomZ = 0.88;
      c.push(...buildLineCloudXZ(r7Left, [r7Left[0], diodeBottomZ]));
      c.push(...buildLineCloudXZ(r7Right, [r7Right[0], diodeBottomZ]));
      c.push(...buildDiodeCloudXZ([r7Left[0], diodeTopZ], [r7Right[0], diodeTopZ], false)); // D1 1N914
      c.push(...buildDiodeCloudXZ([r7Left[0], diodeBottomZ], [r7Right[0], diodeBottomZ], true)); // D2 1N914
      c.push(...buildJunctionCloudXZ(r7Left[0], diodeTopZ));
      c.push(...buildJunctionCloudXZ(r7Right[0], diodeTopZ));
      c.push(...buildJunctionCloudXZ(r7Left[0], diodeBottomZ));
      c.push(...buildJunctionCloudXZ(r7Right[0], diodeBottomZ));

      // -----------------------------------------------------------------
      // Supply / decoupling / connector section. This is kept separate from
      // the signal path, like the KiCad drawing, with explicit visible wires.
      // -----------------------------------------------------------------
      const supplyCenter = [1.66, -0.42];
      c.push(...buildRectOutlineCloudXZ(supplyCenter, 0.18, 0.18, 0.02, 0.010)); // U1C power unit

      const supplyLeftX = 1.57;
      const supplyRightX = 1.75;
      const plus5Z = -0.54;
      const minus5Z = -0.34;
      c.push(...buildCapacitorCloudXZ([1.42, plus5Z], [1.42, minus5Z])); // C3 1nF
      c.push(...buildLineCloudXZ([1.42, plus5Z], [supplyLeftX, plus5Z]));
      c.push(...buildLineCloudXZ([1.42, minus5Z], [supplyLeftX, minus5Z]));

      const connectorCenter = [2.02, -0.26];
      c.push(...buildRectOutlineCloudXZ(connectorCenter, 0.12, 0.36, 0.02, 0.009)); // J2
      const connectorX = 1.96;
      const routeX = 1.82;
      const jPins = [-0.51, -0.37, -0.23, -0.09]; // +5, -5, AGND, Vout
      for (const z of jPins) c.push(...buildLineCloudXZ([connectorX, z], [routeX, z], 0.02, 0.009));

      c.push(...buildPolylineCloudXZ([[routeX, jPins[0]], [supplyRightX, jPins[0]], [supplyRightX, plus5Z]]));
      c.push(...buildPolylineCloudXZ([[routeX, jPins[1]], [supplyRightX, jPins[1]], [supplyRightX, minus5Z]]));

      c.push(...buildPolylineCloudXZ([[routeX, jPins[2]], [1.54, jPins[2]], [1.54, -0.10]]));
      c.push(...buildGroundCloudXZ(1.54, -0.10));

      c.push(...buildPolylineCloudXZ([
        [routeX, jPins[3]],
        [1.56, jPins[3]],
        [1.56, VOUT_Z],
        [VOUT_X, VOUT_Z],
      ]));

      return c;
    })();

    // A compact stylised PCB implementation of the same circuit. The component
    // complement and relative functional grouping match the real oscillator.
    const PCB_ASSEMBLY_BOARD_CLOUD = densifyCloud(buildBox([0, 0, 0], 1.45, 0.03, 1.0, 28, 4, 22));

    const PCB_ASSEMBLY_TRACE_CLOUDS = [
      // Wien bridge / input network.
      densifyCloud(buildBox([-0.48, 0.019, -0.06], 0.28, 0.006, 0.022, 7, 1, 2)),
      densifyCloud(buildBox([-0.55, 0.019, 0.10], 0.022, 0.006, 0.34, 2, 1, 8)),
      densifyCloud(buildBox([-0.36, 0.019, -0.30], 0.40, 0.006, 0.022, 9, 1, 2)),
      densifyCloud(buildBox([-0.10, 0.019, -0.30], 0.022, 0.006, 0.24, 2, 1, 6)),
      // Interstage / central IC routing.
      densifyCloud(buildBox([-0.12, 0.019, -0.11], 0.32, 0.006, 0.022, 8, 1, 2)),
      densifyCloud(buildBox([0.13, 0.019, -0.03], 0.022, 0.006, 0.18, 2, 1, 5)),
      densifyCloud(buildBox([0.22, 0.019, 0.10], 0.34, 0.006, 0.022, 8, 1, 2)),
      // Gain / amplitude-control network.
      densifyCloud(buildBox([-0.18, 0.019, 0.25], 0.44, 0.006, 0.022, 10, 1, 2)),
      densifyCloud(buildBox([0.22, 0.019, 0.25], 0.34, 0.006, 0.022, 8, 1, 2)),
      densifyCloud(buildBox([0.47, 0.019, 0.25], 0.022, 0.006, 0.18, 2, 1, 5)),
      densifyCloud(buildBox([0.46, 0.019, 0.33], 0.22, 0.006, 0.022, 6, 1, 2)),
      densifyCloud(buildBox([0.46, 0.019, 0.39], 0.22, 0.006, 0.022, 6, 1, 2)),
      // Output / connector / rails.
      densifyCloud(buildBox([0.46, 0.019, -0.08], 0.022, 0.006, 0.42, 2, 1, 9)),
      densifyCloud(buildBox([0.57, 0.019, -0.28], 0.22, 0.006, 0.022, 6, 1, 2)),
      densifyCloud(buildBox([0.57, 0.019, -0.18], 0.22, 0.006, 0.022, 6, 1, 2)),
      densifyCloud(buildBox([0.57, 0.019, -0.08], 0.22, 0.006, 0.022, 6, 1, 2)),
      densifyCloud(buildBox([0.57, 0.019, 0.02], 0.22, 0.006, 0.022, 6, 1, 2)),
    ];

    const PCB_ASSEMBLY_PAD_CLOUDS = [];

    function addTwoPadFootprint(x, z, axis = 'x', gap = 0.12, padX = 0.055, padZ = 0.075) {
      const dx = axis === 'x' ? gap * 0.5 : 0;
      const dz = axis === 'z' ? gap * 0.5 : 0;
      PCB_ASSEMBLY_PAD_CLOUDS.push(densifyCloud(buildRectOutlineCloudXZ([x - dx, z - dz], padX, padZ, 0.020, 0.010)));
      PCB_ASSEMBLY_PAD_CLOUDS.push(densifyCloud(buildRectOutlineCloudXZ([x + dx, z + dz], padX, padZ, 0.020, 0.010)));
    }

    // U1: SOIC-style dual op-amp footprint.
    for (let i = 0; i < 4; i++) {
      const z = -0.09 + i * 0.060;
      PCB_ASSEMBLY_PAD_CLOUDS.push(densifyCloud(buildRectOutlineCloudXZ([-0.14, z], 0.055, 0.032, 0.020, 0.008)));
      PCB_ASSEMBLY_PAD_CLOUDS.push(densifyCloud(buildRectOutlineCloudXZ([0.14, z], 0.055, 0.032, 0.020, 0.008)));
    }

    // R1..R7.
    addTwoPadFootprint(-0.48, 0.08, 'x');
    addTwoPadFootprint(-0.12, -0.12, 'x');
    addTwoPadFootprint(-0.42, 0.27, 'x');
    addTwoPadFootprint(0.14, 0.27, 'x');
    addTwoPadFootprint(-0.31, -0.32, 'x');
    addTwoPadFootprint(0.30, 0.20, 'x');
    addTwoPadFootprint(0.50, 0.20, 'x');

    // C1, C2 and C3.
    addTwoPadFootprint(-0.58, -0.10, 'z', 0.11, 0.070, 0.050);
    addTwoPadFootprint(0.00, -0.32, 'x', 0.11, 0.055, 0.070);
    addTwoPadFootprint(0.28, -0.27, 'z', 0.11, 0.070, 0.050);

    // D1/D2 amplitude-control pair.
    addTwoPadFootprint(0.40, 0.33, 'x', 0.13, 0.050, 0.055);
    addTwoPadFootprint(0.40, 0.40, 'x', 0.13, 0.050, 0.055);

    // J2: four-pin power/output header.
    for (let i = 0; i < 4; i++) {
      PCB_ASSEMBLY_PAD_CLOUDS.push(
        densifyCloud(buildRectOutlineCloudXZ([0.61, -0.30 + i * 0.10], 0.075, 0.075, 0.020, 0.009)),
      );
    }

    const PCB_ASSEMBLY_BARE_CLOUD = [
      ...PCB_ASSEMBLY_BOARD_CLOUD,
      ...PCB_ASSEMBLY_TRACE_CLOUDS.flat(),
      ...PCB_ASSEMBLY_PAD_CLOUDS.flat(),
    ];

    // Components arrive in roughly functional order: timing network, gain
    // network, amplitude control, supply decoupling, op-amp, then connector.
    const PCB_ASSEMBLY_COMPONENT_CLOUDS = [
      // R1 1.6k
      densifyCloud(buildBox([-0.48, 0.047, 0.08], 0.16, 0.050, 0.070, 10, 4, 6)),
      // C1 1nF
      densifyCloud(buildBox([-0.58, 0.045, -0.10], 0.075, 0.050, 0.14, 6, 4, 9)),
      // R5 1.6k
      densifyCloud(buildBox([-0.31, 0.047, -0.32], 0.16, 0.050, 0.070, 10, 4, 6)),
      // C2 1nF
      densifyCloud(buildBox([0.00, 0.045, -0.32], 0.14, 0.050, 0.075, 9, 4, 6)),
      // R3 10k
      densifyCloud(buildBox([-0.42, 0.047, 0.27], 0.16, 0.050, 0.070, 10, 4, 6)),
      // R2 470
      densifyCloud(buildBox([-0.12, 0.047, -0.12], 0.16, 0.050, 0.070, 10, 4, 6)),
      // R4 10k
      densifyCloud(buildBox([0.14, 0.047, 0.27], 0.16, 0.050, 0.070, 10, 4, 6)),
      // R6 16k
      densifyCloud(buildBox([0.30, 0.047, 0.20], 0.16, 0.050, 0.070, 10, 4, 6)),
      // R7 4.7k
      densifyCloud(buildBox([0.50, 0.047, 0.20], 0.16, 0.050, 0.070, 10, 4, 6)),
      // D1 1N914
      densifyCloud(buildBox([0.40, 0.045, 0.33], 0.17, 0.045, 0.050, 10, 4, 5)),
      // D2 1N914
      densifyCloud(buildBox([0.40, 0.045, 0.40], 0.17, 0.045, 0.050, 10, 4, 5)),
      // C3 1nF supply decoupling
      densifyCloud(buildBox([0.28, 0.045, -0.27], 0.075, 0.050, 0.14, 6, 4, 9)),
      // U1 ADA4625-2ARDZ
      densifyCloud(buildBox([0.0, 0.065, 0.0], 0.25, 0.10, 0.25, 16, 6, 14)),
      // J2 four-way connector. Four pin bodies are one placement event.
      densifyCloud([
        ...buildBox([0.61, 0.070, -0.30], 0.085, 0.10, 0.075, 6, 6, 5),
        ...buildBox([0.61, 0.070, -0.20], 0.085, 0.10, 0.075, 6, 6, 5),
        ...buildBox([0.61, 0.070, -0.10], 0.085, 0.10, 0.075, 6, 6, 5),
        ...buildBox([0.61, 0.070, 0.00], 0.085, 0.10, 0.075, 6, 6, 5),
      ]),
    ];

    const ASSEMBLY_MORPH_COUNT = 3218;
    const SCHEMATIC_MORPH_CLOUD = resampleCloud(SCHEMATIC_CLOUD, ASSEMBLY_MORPH_COUNT);
    const PCB_MORPH_CLOUD = resampleCloud(PCB_ASSEMBLY_BARE_CLOUD, ASSEMBLY_MORPH_COUNT);

    const FIXTURE_FRAME_CLOUDS = [
      densifyCloud(buildBox([0, -0.19, 0], 1.78, 0.06, 1.28, 24, 5, 20), 2.3),
      densifyCloud(buildBox([0, -0.11, -0.63], 1.62, 0.18, 0.08, 22, 8, 3), 2.15),
      densifyCloud(buildBox([0, -0.11, 0.63], 1.62, 0.18, 0.08, 22, 8, 3), 2.15),
      densifyCloud(buildBox([-0.82, -0.11, 0], 0.08, 0.18, 1.12, 3, 8, 18), 2.15),
      densifyCloud(buildBox([0.82, -0.11, 0], 0.08, 0.18, 1.12, 3, 8, 18), 2.15),
      densifyCloud(buildBox([-0.82, -0.04, -0.55], 0.12, 0.24, 0.12, 5, 10, 5), 2.0),
      densifyCloud(buildBox([0.82, -0.04, -0.55], 0.12, 0.24, 0.12, 5, 10, 5), 2.0),
      densifyCloud(buildBox([-0.82, -0.04, 0.55], 0.12, 0.24, 0.12, 5, 10, 5), 2.0),
      densifyCloud(buildBox([0.82, -0.04, 0.55], 0.12, 0.24, 0.12, 5, 10, 5), 2.0),
    ];

    const PAD_MARKER_CLOUDS = [];
    const padXs = [-0.52, -0.28, 0, 0.28, 0.52];
    const padZs = [-0.34, -0.12, 0.12, 0.34];
    for (const x of padXs) {
      for (const z of padZs) {
        PAD_MARKER_CLOUDS.push(decimate(buildBox([x, -0.011, z], 0.07, 0.01, 0.05, 4, 1, 3), 1));
      }
    }

    const NAIL_LAYOUT = [];
    let nailSeq = 0;
    for (let ix = -4; ix <= 4; ix++) {
      for (let iz = -3; iz <= 3; iz++) {
        const keep = rand2(ix, iz, 21);
        const radialBias = 1 - clamp((Math.abs(ix) / 4 + Math.abs(iz) / 3) * 0.45, 0, 0.55);
        if (keep > 0.78 + radialBias * 0.08) continue;
        if (Math.abs(ix) <= 1 && Math.abs(iz) <= 1 && rand2(ix, iz, 22) > 0.62) continue;

        const x = ix * 0.125 + (rand2(ix, iz, 23) - 0.5) * 0.04;
        const z = iz * 0.11 + (rand2(ix, iz, 24) - 0.5) * 0.038;
        const r1 = rand2(ix, iz, 1);
        const r2 = rand2(ix, iz, 2);
        const r3 = rand2(ix, iz, 3);
        const r4 = rand2(ix, iz, 4);
        NAIL_LAYOUT.push({
          x,
          z,
          seq: nailSeq++,
          group: Math.floor(r1 * 5),
          activationA: 0.55 + r1 * 1.9,
          activationB: 3.2 + r2 * 2.35,
          activationC: 6.2 + r3 * 2.25,
          activationD: 8.5 + r4 * 1.0,
          widthA: 0.16 + rand2(ix, iz, 5) * 0.1,
          widthB: 0.16 + rand2(ix, iz, 6) * 0.11,
          widthC: 0.16 + rand2(ix, iz, 7) * 0.1,
          widthD: 0.12 + rand2(ix, iz, 8) * 0.08,
          phase: rand2(ix, iz, 9) * PI * 2,
        });
      }
    }

    function transformCloudToWorld(cloud, frame = null) {
      const R = frame?.R || IDENTITY;
      const t = frame?.t || [0, 0, 0];
      return cloud.map((point) => ({
        p: vAdd(t, mv(R, point.p)),
        n: norm(mv(R, point.n)),
      }));
    }

    function normalizeTransitionCloud(cloud, targetSpan = 1.82) {
      if (!cloud.length) return [];

      let minX = Infinity;
      let minY = Infinity;
      let minZ = Infinity;
      let maxX = -Infinity;
      let maxY = -Infinity;
      let maxZ = -Infinity;

      for (const point of cloud) {
        minX = Math.min(minX, point.p[0]);
        minY = Math.min(minY, point.p[1]);
        minZ = Math.min(minZ, point.p[2]);
        maxX = Math.max(maxX, point.p[0]);
        maxY = Math.max(maxY, point.p[1]);
        maxZ = Math.max(maxZ, point.p[2]);
      }

      const cx = (minX + maxX) * 0.5;
      const cy = (minY + maxY) * 0.5;
      const cz = (minZ + maxZ) * 0.5;
      const span = Math.max(maxX - minX, maxY - minY, maxZ - minZ, 1e-6);
      const scale = targetSpan / span;

      return cloud.map((point) => ({
        p: [
          (point.p[0] - cx) * scale,
          (point.p[1] - cy) * scale,
          (point.p[2] - cz) * scale,
        ],
        n: point.n,
      }));
    }

    function makeTransitionCloud(cloud) {
      return resampleCloud(normalizeTransitionCloud(cloud), TRANSITION_MORPH_COUNT);
    }

    const TRANSITION_MORPH_COUNT = 4800;
    const TRANSITION_ROBOT_BASE = [-0.044, -0.62, -0.028];

    function buildRobotTransitionCloud(probeIndex = 0) {
      const clampedIndex = Math.max(0, Math.min(HEART_PROBES.length - 1, probeIndex));
      const q = solveProbeTipIK(
        REST_Q.slice(),
        HEART_PROBES[clampedIndex].p,
        [0, -1, 0],
        TRANSITION_ROBOT_BASE,
        18,
      );
      const { frames, flange } = fk(q, TRANSITION_ROBOT_BASE);

      return makeTransitionCloud([
        ...LINK_POINT_CLOUDS.flatMap((linkCloud, i) => transformCloudToWorld(linkCloud, frames[i])),
        ...transformCloudToWorld(FLANGE_POINT_CLOUD_DENSE, flange),
        ...transformCloudToWorld(SCANNER_POINT_CLOUD_DENSE, flange),
        ...HEART_SURFACE_CLOUD_DENSE,
        ...HEART_TRAY_CLOUD,
      ]);
    }

    function buildBedTransitionCloud(boardY = 0.13, pinTipY = 0.112) {
      const boardFrame = { R: IDENTITY, t: [0, boardY, 0] };
      const nails = [];

      for (const nail of NAIL_LAYOUT) {
        nails.push(
          ...buildCylinder([nail.x, -0.28, nail.z], [nail.x, pinTipY, nail.z], 0.015, 7, 12, 2),
          ...buildCylinder([nail.x, pinTipY - 0.012, nail.z], [nail.x, pinTipY + 0.006, nail.z], 0.024, 4, 12, 2),
        );
      }

      return makeTransitionCloud([
        ...transformCloudToWorld(PCB_BOARD_CLOUD, boardFrame),
        ...PCB_COMPONENT_CLOUDS.flatMap((cloud) => transformCloudToWorld(cloud, boardFrame)),
        ...PCB_DETAIL_CLOUDS.flatMap((cloud) => transformCloudToWorld(cloud, boardFrame)),
        ...PAD_MARKER_CLOUDS.flatMap((cloud) => transformCloudToWorld(cloud, boardFrame)),
        ...FIXTURE_FRAME_CLOUDS.flat(),
        ...nails,
      ]);
    }

    function buildAssemblyTransitionCloud(populated = false) {
      const cloud = populated
        ? [
          ...PCB_ASSEMBLY_BARE_CLOUD,
          ...PCB_ASSEMBLY_COMPONENT_CLOUDS.flat(),
        ]
        : SCHEMATIC_CLOUD;
      return makeTransitionCloud(cloud);
    }

    const ROBOT_ENTRY_TRANSITION_CLOUD = buildRobotTransitionCloud(0);
    const ROBOT_EXIT_TRANSITION_CLOUD = buildRobotTransitionCloud(HEART_PROBES.length - 1);
    const BED_ENTRY_TRANSITION_CLOUD = buildBedTransitionCloud(0.40, -0.13);
    const BED_EXIT_TRANSITION_CLOUD = buildBedTransitionCloud(0.13, 0.112);
    const ASSEMBLY_ENTRY_TRANSITION_CLOUD = buildAssemblyTransitionCloud(false);
    const ASSEMBLY_EXIT_TRANSITION_CLOUD = buildAssemblyTransitionCloud(true);

    const state = {
      width: 0,
      height: 0,
      dpr: 1,
      running: false,
      visible: true,
      reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      raf: 0,
      base: [-0.044, -0.62, -0.028],

      // IK/simulation state is updated at SIMULATION_HZ; qRender is smoothly
      // interpolated at display refresh rate.
      qSim: REST_Q.slice(),
      qRender: REST_Q.slice(),
      nextSimulationTime: null,
      lastFrameMs: null,

      robotFit: { scale: 0 },
      bedFit: { scale: 0 },
      assemblyFit: { scale: 0 },
      transitionFit: { scale: 0 },
      currentScene: '',
    };

    const media = window.matchMedia('(prefers-reduced-motion: reduce)');
    const onMotionChange = (event) => {
      state.reducedMotion = event.matches;
      if (state.reducedMotion) {
        stop();
        state.qSim = REST_Q.slice();
        state.qRender = REST_Q.slice();
        render(0, 0);
      } else {
        state.nextSimulationTime = null;
        state.lastFrameMs = null;
        sync();
      }
    };
    media.addEventListener?.('change', onMotionChange);

    function resize() {
      const rect = frameEl.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, DPR_CAP);
      const width = Math.max(1, Math.round(rect.width * dpr));
      const height = Math.max(1, Math.round(rect.height * dpr));

      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width;
        canvas.height = height;
      }

      state.width = rect.width;
      state.height = rect.height;
      state.dpr = dpr;
      state.robotFit.scale = 0;
      state.bedFit.scale = 0;
      state.assemblyFit.scale = 0;
      state.transitionFit.scale = 0;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    const resizeObserver = new ResizeObserver(() => {
      resize();
      render(performance.now() * 0.001, 0);
    });
    resizeObserver.observe(frameEl);

    const intersectionObserver = new IntersectionObserver(
      (entries) => {
        state.visible = !!entries[0]?.isIntersecting;
        sync();
      },
      { threshold: 0.05 },
    );
    intersectionObserver.observe(root);

    document.addEventListener('visibilitychange', sync);

    function setScene(sceneName) {
      if (state.currentScene === sceneName) return;
      state.currentScene = sceneName;

      if (sceneName === 'robot') {
        state.robotFit.scale = 0;

        // Start already settled at the first probe pose. This avoids the large,
        // non-physical transient from REST_Q when the scene first appears.
        const initialMotion = heartProbeMotion(0, ROBOT_SCENE_DURATION);
        const initialQ = solveProbeTipIK(
          REST_Q.slice(),
          initialMotion.target,
          initialMotion.targetDirection,
          state.base,
          18,
        );

        state.qSim = initialQ.slice();
        state.qRender = initialQ.slice();
        state.nextSimulationTime = null;
      }

      if (sceneName === 'bed') {
        state.bedFit.scale = 0;
        state.nextSimulationTime = null;
      }

      if (sceneName === 'assembly') {
        state.assemblyFit.scale = 0;
        state.nextSimulationTime = null;
      }
    }

    function makeCamera(eye, target) {
      const upRef = [0, 1, 0];
      const forward = norm(vSub(target, eye));
      const right = norm(cross(forward, upRef));
      const up = cross(right, forward);
      return { eye, target, forward, right, up };
    }

    function project(point, camera) {
      const rel = vSub(point, camera.eye);
      const x = dot(rel, camera.right);
      const y = dot(rel, camera.up);
      const z = dot(rel, camera.forward);
      if (z <= 0.01) return null;
      return { x: x / z, y: -y / z, z };
    }

    function fitAnchoredDots(dots, anchor, fitState, opts = {}, measureDots = dots) {
      if (!dots.length || !anchor || !measureDots.length) return;

      const screenAnchorX = state.width * (opts.screenX ?? 0.54);
      const screenAnchorY = state.height * (opts.screenY ?? 0.84);

      // Calculate the scene scale only once after resize/scene entry. Camera
      // motion may move the projected anchor, but the scale remains fixed.
      if (!fitState.scale) {
        let minX = Infinity;
        let maxX = -Infinity;
        let minY = Infinity;
        let maxY = -Infinity;

        for (const p of measureDots) {
          if (p.x < minX) minX = p.x;
          if (p.x > maxX) maxX = p.x;
          if (p.y < minY) minY = p.y;
          if (p.y > maxY) maxY = p.y;
        }

        const left = state.width * (opts.left ?? 0.14);
        const right = state.width * (opts.right ?? 0.94);
        const top = state.height * (opts.top ?? 0.08);
        const bottom = state.height * (opts.bottom ?? 0.96);

        const spanLeft = Math.max(anchor.x - minX, 1e-6);
        const spanRight = Math.max(maxX - anchor.x, 1e-6);
        const spanUp = Math.max(anchor.y - minY, 1e-6);
        const spanDown = Math.max(maxY - anchor.y, 1e-6);

        fitState.scale = Math.min(
          (screenAnchorX - left) / spanLeft,
          (right - screenAnchorX) / spanRight,
          (screenAnchorY - top) / spanUp,
          (bottom - screenAnchorY) / spanDown,
        ) * 0.96;
      }

      for (const p of dots) {
        p.x = screenAnchorX + (p.x - anchor.x) * fitState.scale;
        p.y = screenAnchorY + (p.y - anchor.y) * fitState.scale;
      }
    }

    function applyHeartProjection(dots, zoomMix) {
      // project() returns normalised perspective coordinates (x/z, y/z).
      // Map those directly to pixels with a controlled focal length instead of
      // re-fitting animated geometry every frame.
      const minDim = Math.min(state.width, state.height);
      const focal = minDim * lerp(0.76, 1.02, zoomMix);
      const cx = state.width * lerp(0.52, 0.50, zoomMix);
      const cy = state.height * lerp(0.54, 0.63, zoomMix);

      for (const p of dots) {
        p.x = cx + p.x * focal;
        p.y = cy + p.y * focal;
      }
    }

    function pushCloud(dots, cloud, frame, camera, lightDir, kind, alphaMul = 1, color = 'black') {
      const R = frame?.R || IDENTITY;
      const t = frame?.t || [0, 0, 0];
      for (const point of cloud) {
        const world = vAdd(t, mv(R, point.p));
        const normal = norm(mv(R, point.n));
        const proj = project(world, camera);
        if (!proj) continue;
        const lit = clamp(0.24 + 0.76 * Math.max(0, dot(normal, lightDir)));
        const depthFade = clamp(1.35 - proj.z / 5.8, 0.32, 1);
        dots.push({
          x: proj.x,
          y: proj.y,
          z: proj.z,
          r: 0,
          kind,
          color,
          a: lit * depthFade * alphaMul,
        });
      }
    }

    function sizeAndDrawDots(dots) {
      if (!dots.length) return;

      let nearestZ = Infinity;
      let farthestZ = -Infinity;
      for (const p of dots) {
        if (p.z < nearestZ) nearestZ = p.z;
        if (p.z > farthestZ) farthestZ = p.z;
      }
      const depthSpan = Math.max(farthestZ - nearestZ, 1e-6);

      const batches = {
        black: Array.from({ length: DEPTH_BUCKETS }, () =>
          Array.from({ length: ALPHA_BUCKETS }, () => ({ points: [], alphaSum: 0 }))),
        blue: Array.from({ length: DEPTH_BUCKETS }, () =>
          Array.from({ length: ALPHA_BUCKETS }, () => ({ points: [], alphaSum: 0 }))),
      };

      for (const p of dots) {
        const near = clamp((farthestZ - p.z) / depthSpan);
        const easedNear = smooth(near);

        if (p.kind === 'flange' || p.kind === 'scanner') {
          p.r = 0.24 + easedNear * 0.42;
        } else if (p.kind === 'base') {
          p.r = 0.27 + easedNear * 0.48;
        } else if (p.kind === 'registration') {
          p.r = 0.42 + easedNear * 0.70;
        } else if (p.kind === 'heart') {
          p.r = 0.25 + easedNear * 0.46;
        } else if (p.kind === 'pin-active') {
          p.r = 0.38 + easedNear * 0.68;
        } else if (p.kind === 'pin') {
          p.r = 0.31 + easedNear * 0.56;
        } else if (p.kind === 'fixture') {
          p.r = 0.22 + easedNear * 0.40;
        } else if (p.kind === 'pcb-detail') {
          p.r = 0.23 + easedNear * 0.42;
        } else if (p.kind === 'pcb') {
          p.r = 0.24 + easedNear * 0.46;
        } else {
          p.r = 0.25 + easedNear * 0.48;
        }

        let alpha;
        if (p.kind === 'base') alpha = 0.18 + p.a * 0.78;
        else if (p.kind === 'registration') alpha = 0.22 + p.a * 0.76;
        else if (p.kind === 'heart') alpha = 0.14 + p.a * 0.72;
        else if (p.kind === 'pin-active') alpha = 0.16 + p.a * 0.84;
        else if (p.kind === 'pin') alpha = 0.16 + p.a * 0.78;
        else if (p.kind === 'pcb-detail') alpha = 0.14 + p.a * 0.72;
        else alpha = 0.13 + p.a * 0.72;
        alpha = clamp(alpha, 0, 1);

        const depthIndex = Math.min(
          DEPTH_BUCKETS - 1,
          Math.floor(near * DEPTH_BUCKETS),
        );
        const alphaIndex = Math.min(
          ALPHA_BUCKETS - 1,
          Math.floor(alpha * ALPHA_BUCKETS),
        );

        const colorKey = p.color === 'blue' ? 'blue' : 'black';
        const batch = batches[colorKey][depthIndex][alphaIndex];
        batch.points.push(p);
        batch.alphaSum += alpha;
      }

      // Far-to-near at bucket resolution; blue registration data is drawn after
      // the structural cloud at each depth so the measured surface stays legible.
      for (let depthIndex = 0; depthIndex < DEPTH_BUCKETS; depthIndex++) {
        for (const colorKey of ['black', 'blue']) {
          const rgb = colorKey === 'blue' ? BLUE : BLACK;

          for (let alphaIndex = 0; alphaIndex < ALPHA_BUCKETS; alphaIndex++) {
            const batch = batches[colorKey][depthIndex][alphaIndex];
            if (!batch.points.length) continue;

            const alpha = batch.alphaSum / batch.points.length;
            ctx.fillStyle = `rgba(${rgb}, ${alpha})`;
            ctx.beginPath();

            for (const p of batch.points) {
              ctx.moveTo(p.x + p.r, p.y);
              ctx.arc(p.x, p.y, p.r, 0, PI * 2);
            }

            ctx.fill();
          }
        }
      }
    }



    function updateCaption(primaryText, secondaryText = '', blend = 0) {
      if (!captionPrimary || !captionSecondary) return;
      captionPrimary.textContent = primaryText;
      captionSecondary.textContent = secondaryText || primaryText;
      const t = clamp(blend);
      captionPrimary.style.opacity = `${1 - t}`;
      captionSecondary.style.opacity = secondaryText ? `${t}` : '0';
    }


    function getTransitionCamera(globalTime) {
      return makeCamera(
        [
          1.52 + 0.025 * Math.cos(globalTime * 0.18),
          1.14 + 0.02 * Math.sin(globalTime * 0.16 + 0.5),
          1.98 + 0.03 * Math.sin(globalTime * 0.14 + 1.1),
        ],
        [0, 0.02, 0],
      );
    }


    function drawMorphTransition(mix, fromCloud, toCloud, globalTime) {
      const t = easeInOut(clamp(mix));
      const lightDir = norm([0.58, 1.0, 0.46]);
      const camera = getTransitionCamera(globalTime);

      const morphCloud = [];
      const count = Math.min(fromCloud.length, toCloud.length);
      for (let i = 0; i < count; i++) {
        const a = fromCloud[i];
        const b = toCloud[i];
        morphCloud.push({
          p: [
            lerp(a.p[0], b.p[0], t),
            lerp(a.p[1], b.p[1], t),
            lerp(a.p[2], b.p[2], t),
          ],
          n: norm(vLerp(a.n, b.n, t)),
        });
      }

      const dots = [];
      const sourceHold = clamp((0.28 - t) / 0.28);
      const destHold = clamp((t - 0.60) / 0.40);
      pushCloud(dots, morphCloud, null, camera, lightDir, 'pcb', 0.84 + 0.10 * Math.sin(t * PI));
      if (sourceHold > 0) {
        pushCloud(dots, fromCloud, null, camera, lightDir, 'pcb-detail', 0.34 + sourceHold * 0.42);
      }
      if (destHold > 0) {
        pushCloud(dots, toCloud, null, camera, lightDir, 'pcb-detail', 0.22 + destHold * 0.78);
      }
      const anchor = project([0, 0, 0], camera);
      fitAnchoredDots(dots, anchor, state.transitionFit, {
        screenX: 0.53,
        screenY: 0.57,
        left: 0.05,
        right: 0.975,
        top: 0.05,
        bottom: 0.955,
      });
      sizeAndDrawDots(dots);
    }

    function getHeartSceneCamera(localTime, duration, globalTime, motion) {
      // Keep the camera wide while the first probe approaches. Once the first
      // contact has been made, transition to a fixed close-up viewpoint based
      // on the real videos rather than orbiting with the local surface normal.
      const zoomMix = easeInOut(clamp((localTime - 3.8) / 2.8));

      // Slightly elevated establishing view: whole robot, tiny specimen.
      const wideEye = [
        1.22 + 0.020 * Math.cos(globalTime * 0.14),
        1.20 + 0.014 * Math.sin(globalTime * 0.12),
        1.64 + 0.016 * Math.sin(globalTime * 0.13),
      ];
      const wideTarget = [0.12, 0.13, 0.10];

      // Fixed oblique close-up. The tool enters from above/right and the heart
      // remains low in the frame, matching the character of the reference.
      const closeEye = [
        HEART_CENTER[0] + 0.40,
        HEART_CENTER[1] + 0.34,
        HEART_CENTER[2] + 0.52,
      ];
      const closeTarget = [
        HEART_CENTER[0],
        HEART_CENTER[1] + 0.018,
        HEART_CENTER[2],
      ];

      const eye = vLerp(wideEye, closeEye, zoomMix);
      const target = vLerp(wideTarget, closeTarget, zoomMix);

      return {
        camera: makeCamera(eye, target),
        zoomMix,
      };
    }

    function heartProbeMotion(localTime, duration) {
      const count = HEART_PROBES.length;
      const segmentDuration = duration / count;
      const rawSegment = clamp(localTime / segmentDuration, 0, count - 1e-6);
      const index = Math.min(count - 1, Math.floor(rawSegment));
      const phase = rawSegment - index;

      const current = HEART_PROBES[index];
      const previous = HEART_PROBES[Math.max(0, index - 1)];

      // These are now explicit probe-tip targets. Contact means the actual tip
      // is commanded to the tissue point itself; retract is directly above it.
      const approachAxis = [0, 1, 0];

      const previousContact = previous.p;
      const previousRetract = vAdd(
        previous.p,
        vScale(approachAxis, PROBE_RETRACT_DISTANCE),
      );
      const currentRetract = vAdd(
        current.p,
        vScale(approachAxis, PROBE_RETRACT_DISTANCE),
      );
      const currentContact = current.p;

      // The first probe starts already in contact and simply settles. Thereafter
      // each point gets a long hold, a modest retract, a slow local traverse,
      // a controlled approach and another contact dwell.
      if (index === 0) {
        let target;
        if (phase < 0.28) {
          target = currentRetract;
        } else if (phase < 0.78) {
          const s = easeInOut((phase - 0.28) / 0.50);
          target = vLerp(currentRetract, currentContact, s);
        } else {
          target = currentContact;
        }

        return {
          index,
          phase,
          target,
          targetDirection: [0, -1, 0],
          registeredCount: phase >= 0.78 ? 1 : 0,
        };
      }

      let target;
      let directionNormal;

      if (phase < 0.25) {
        // Hold the previous contact before moving away.
        target = previousContact;
        directionNormal = previous.n;
      } else if (phase < 0.42) {
        // Small normal-direction retract.
        const s = easeInOut((phase - 0.25) / 0.17);
        target = vLerp(previousContact, previousRetract, s);
        directionNormal = previous.n;
      } else if (phase < 0.67) {
        // Translate between neighbouring registration locations while clear.
        const s = easeInOut((phase - 0.42) / 0.25);
        target = vLerp(previousRetract, currentRetract, s);
        directionNormal = norm(vLerp(previous.n, current.n, s));
      } else if (phase < 0.87) {
        // Controlled approach along the new local surface normal.
        const s = easeInOut((phase - 0.67) / 0.20);
        target = vLerp(currentRetract, currentContact, s);
        directionNormal = current.n;
      } else {
        // Contact / settling dwell.
        target = currentContact;
        directionNormal = current.n;
      }

      return {
        index,
        phase,
        target,
        targetDirection: [0, -1, 0],
        registeredCount: index + (phase >= 0.87 ? 1 : 0),
      };
    }

    function stepRobotSimulation(localTime, duration) {
      const motion = heartProbeMotion(localTime, duration);
      const contactOrApproach =
        (motion.index === 0 && motion.phase >= 0.62)
        || (motion.index > 0 && motion.phase >= 0.67);

      const qSolved = solveProbeTipIK(
        state.qSim.slice(),
        motion.target,
        motion.targetDirection,
        state.base,
        contactOrApproach ? 8 : 5,
      );

      const maxJointStep = MAX_JOINT_SPEED_RAD_S * SIMULATION_DT;
      for (let i = 0; i < state.qSim.length; i++) {
        const delta = clamp(
          qSolved[i] - state.qSim[i],
          -maxJointStep,
          maxJointStep,
        );
        state.qSim[i] += delta;
      }
    }

    function updateRobotSimulation(localTime, duration) {
      if (state.reducedMotion) return;

      if (state.nextSimulationTime === null) {
        stepRobotSimulation(localTime, duration);
        state.nextSimulationTime = localTime + SIMULATION_DT;
        return;
      }

      let steps = 0;
      while (localTime >= state.nextSimulationTime && steps < 2) {
        stepRobotSimulation(state.nextSimulationTime, duration);
        state.nextSimulationTime += SIMULATION_DT;
        steps++;
      }

      if (localTime - state.nextSimulationTime > SIMULATION_DT * 2) {
        state.nextSimulationTime = localTime + SIMULATION_DT;
      }
    }

    function updateRenderJoints(deltaSeconds) {
      if (state.reducedMotion) {
        state.qRender = REST_Q.slice();
        return;
      }

      const blend = 1 - Math.exp(-10 * Math.max(0, deltaSeconds));
      for (let i = 0; i < state.qRender.length; i++) {
        state.qRender[i] = lerp(state.qRender[i], state.qSim[i], blend);
      }
    }

    function pushRegistrationPoint(dots, probe, camera, intensity = 1) {
      const tangentA = norm(cross(probe.n, [0, 1, 0]));
      const tangent = len(tangentA) > 1e-4 ? tangentA : [1, 0, 0];
      const bitangent = norm(cross(probe.n, tangent));

      const samples = [
        [0, 0],
        [0.0045, 0],
        [-0.0045, 0],
        [0, 0.0045],
        [0, -0.0045],
      ];

      for (const [u, v] of samples) {
        const p = vAdd(
          probe.p,
          vAdd(
            vScale(tangent, u),
            vScale(bitangent, v),
          ),
        );
        const proj = project(p, camera);
        if (!proj) continue;
        dots.push({
          x: proj.x,
          y: proj.y,
          z: proj.z,
          r: 0,
          kind: 'registration',
          color: 'blue',
          a: intensity,
        });
      }
    }

    function pushProbeContactBridge(dots, flange, probe, camera, lightDir) {
      const toolZ = [flange.R[2], flange.R[5], flange.R[8]];
      const renderedTip = vAdd(
        flange.t,
        vScale(toolZ, SCANNER_TOOL_LENGTH),
      );

      const gap = len(vSub(probe.p, renderedTip));
      if (gap > 0.012) return;

      const bridge = buildCylinder(
        renderedTip,
        probe.p,
        0.0035,
        3,
        10,
        1,
      );

      pushCloud(
        dots,
        bridge,
        null,
        camera,
        lightDir,
        'scanner',
        0.95,
      );
    }

    function drawHeartRegistrationScene(localTime, duration, globalTime, deltaSeconds) {
      updateRobotSimulation(localTime, duration);
      updateRenderJoints(deltaSeconds);

      const motion = heartProbeMotion(localTime, duration);
      const { camera, zoomMix } = getHeartSceneCamera(localTime, duration, globalTime, motion);
      const lightDir = norm([0.58, 1.0, 0.5]);
      const { frames, flange } = fk(state.qRender, state.base);
      const dots = [];

      for (let i = 0; i < LINK_POINT_CLOUDS.length; i++) {
        pushCloud(
          dots,
          LINK_POINT_CLOUDS[i],
          frames[i],
          camera,
          lightDir,
          i === 0 ? 'base' : 'link',
          i === 0 ? 1.08 : 0.82,
        );
      }

      pushCloud(dots, FLANGE_POINT_CLOUD, flange, camera, lightDir, 'flange', 0.78);
      pushCloud(dots, SCANNER_POINT_CLOUD, flange, camera, lightDir, 'scanner', 0.9);

      const contactDwell =
        (motion.index === 0 && motion.phase >= 0.78)
        || (motion.index > 0 && motion.phase >= 0.87);

      if (contactDwell) {
        pushProbeContactBridge(
          dots,
          flange,
          HEART_PROBES[motion.index],
          camera,
          lightDir,
        );
      }

      // Add detail progressively as the camera moves in.
      if (zoomMix > 0.15) {
        const denseMix = clamp((zoomMix - 0.15) / 0.85);
        pushCloud(
          dots,
          FLANGE_POINT_CLOUD_DENSE,
          flange,
          camera,
          lightDir,
          'flange',
          0.12 + denseMix * 0.32,
        );
        pushCloud(
          dots,
          SCANNER_POINT_CLOUD_DENSE,
          flange,
          camera,
          lightDir,
          'scanner',
          0.12 + denseMix * 0.38,
        );
      }

      pushCloud(dots, HEART_SURFACE_CLOUD, null, camera, lightDir, 'heart', 0.88);
      pushCloud(dots, HEART_TRAY_CLOUD, null, camera, lightDir, 'fixture', 0.30);

      if (zoomMix > 0.12) {
        const denseMix = clamp((zoomMix - 0.12) / 0.88);
        pushCloud(
          dots,
          HEART_SURFACE_CLOUD_DENSE,
          null,
          camera,
          lightDir,
          'heart',
          0.10 + denseMix * 0.42,
        );
      }

      // Compact blue registration points only. No surface-normal lines.
      for (let i = 0; i < motion.registeredCount; i++) {
        pushRegistrationPoint(dots, HEART_PROBES[i], camera, 0.82);
      }

      if (
        (motion.index === 0 && motion.phase >= 0.72)
        || (motion.index > 0 && motion.phase >= 0.78)
      ) {
        pushRegistrationPoint(dots, HEART_PROBES[motion.index], camera, 1.0);
      }

      applyHeartProjection(dots, zoomMix);
      sizeAndDrawDots(dots);
    }

    function getBedSceneCamera(t, globalTime) {
      const camMix = easeInOut(clamp((t - 0.2) / 0.5));
      const eyeTop = [2.15, 1.55, 2.25];
      const eyeBottom = [1.26, -0.3, 1.88];
      const targetTop = [0, -0.02, 0];
      const targetBottom = [0, -0.02, 0.03];
      const eye = vLerp(eyeTop, eyeBottom, camMix);
      const target = vLerp(targetTop, targetBottom, camMix);
      eye[0] += 0.08 * Math.cos(globalTime * 0.23 + 0.4);
      eye[2] += 0.05 * Math.sin(globalTime * 0.19 + 1.0);
      return makeCamera(eye, target);
    }


    function nailActivityLevel(nail, testClock) {
      const individual = Math.max(
        pulse(testClock, nail.activationA, nail.widthA),
        pulse(testClock, nail.activationB, nail.widthB),
        pulse(testClock, nail.activationC, nail.widthC),
        pulse(testClock, nail.activationD, nail.widthD),
      );

      const testPhases = Math.max(
        nail.group === 0 ? pulse(testClock, 1.9, 0.42) : 0,
        nail.group === 1 ? pulse(testClock, 3.8, 0.48) : 0,
        nail.group === 2 ? pulse(testClock, 5.9, 0.52) : 0,
        nail.group === 3 ? pulse(testClock, 7.4, 0.5) : 0,
        nail.group === 4 ? pulse(testClock, 8.9, 0.4) : 0,
      );

      const flicker = Math.max(0, Math.sin(testClock * (2.8 + nail.group * 0.23) + nail.phase)) * 0.24;
      const verify = pulse(testClock, 9.25 + nail.group * 0.07, 0.14) * (0.4 + 0.6 * rand2(nail.x, nail.z, 31));
      return Math.max(individual, testPhases * (0.55 + flicker), verify);
    }

    function drawBedOfNailsScene(localTime, duration, globalTime) {
      const t = clamp(localTime / duration);
      const lowerT = easeInOut(clamp(t / 0.28));
      const nailsT = easeInOut(clamp((t - 0.22) / 0.22));
      const testT = clamp((t - 0.42) / 0.58);

      const boardY = lerp(0.4, 0.13, lowerT);
      const pinTipY = lerp(-0.13, boardY - 0.018, nailsT);
      const camera = getBedSceneCamera(t, globalTime);
      const lightDir = norm([0.62, 1.0, 0.4]);
      const dots = [];

      const boardFrame = { R: IDENTITY, t: [0, boardY, 0] };
      pushCloud(dots, PCB_BOARD_CLOUD, boardFrame, camera, lightDir, 'pcb', 0.8);
      for (const cloud of PCB_COMPONENT_CLOUDS) {
        pushCloud(dots, cloud, boardFrame, camera, lightDir, 'pcb', 0.82);
      }
      for (const cloud of PCB_DETAIL_CLOUDS) {
        pushCloud(dots, cloud, boardFrame, camera, lightDir, 'pcb-detail', 0.68);
      }
      for (const cloud of PAD_MARKER_CLOUDS) {
        pushCloud(dots, cloud, boardFrame, camera, lightDir, 'pcb-detail', 0.66);
      }

      for (const cloud of FIXTURE_FRAME_CLOUDS) {
        pushCloud(dots, cloud, null, camera, lightDir, 'fixture', 0.55);
      }

      const activityTime = testT * 10.4;
      for (const nail of NAIL_LAYOUT) {
        const activity = nailActivityLevel(nail, activityTime);
        const active = activity > 0.24;
        const shaftCloud = buildCylinder([nail.x, -0.28, nail.z], [nail.x, pinTipY, nail.z], 0.015, 9, 14, 2);
        const headCloud = buildCylinder([nail.x, pinTipY - 0.012, nail.z], [nail.x, pinTipY + 0.006, nail.z], 0.024, 5, 14, 2);
        const nailCloud = [
          ...decimate(shaftCloud, active ? 1 : 2, nail.seq % 2),
          ...decimate(headCloud, 1),
        ];
        pushCloud(
          dots,
          nailCloud,
          null,
          camera,
          lightDir,
          active ? 'pin-active' : 'pin',
          active ? 1.0 + activity * 0.5 : 0.78,
          active ? 'blue' : 'black',
        );
      }

      const fixtureAnchor = project([0, -0.19, 0], camera);
      fitAnchoredDots(dots, fixtureAnchor, state.bedFit, {
        screenX: 0.57,
        screenY: 0.72,
        left: 0.1,
        right: 0.96,
        top: 0.07,
        bottom: 0.97,
        smooth: 0.1,
      });

      sizeAndDrawDots(dots);
    }


    function getAssemblySceneCamera(t, globalTime) {
      const morphCamera = easeInOut(clamp((t - 0.18) / 0.30));
      const eyeSchematic = [0.92, 3.55, 1.72];
      const eyeBoard = [1.62, 1.25, 1.86];
      const targetSchematic = [0.10, 0.0, 0.04];
      const targetBoard = [0, 0.02, 0.02];
      const eye = vLerp(eyeSchematic, eyeBoard, morphCamera);
      const target = vLerp(targetSchematic, targetBoard, morphCamera);
      eye[0] += 0.025 * Math.cos(globalTime * 0.19);
      eye[2] += 0.020 * Math.sin(globalTime * 0.17);
      return makeCamera(eye, target);
    }

    function drawAssemblyScene(localTime, duration, globalTime) {
      const t = clamp(localTime / duration);
      const camera = getAssemblySceneCamera(t, globalTime);
      const lightDir = norm([0.55, 1.0, 0.46]);
      const dots = [];

      // 0-24%: schematic holds; 24-47%: it physically morphs into the bare PCB.
      const morph = easeInOut(clamp((t - 0.24) / 0.23));
      const bareHold = clamp((t - 0.44) / 0.06);

      const morphCloud = [];
      for (let i = 0; i < ASSEMBLY_MORPH_COUNT; i++) {
        const a = SCHEMATIC_MORPH_CLOUD[i];
        const b = PCB_MORPH_CLOUD[i];
        const settle = smooth(morph);
        morphCloud.push({
          p: [
            lerp(a.p[0], b.p[0], settle),
            lerp(a.p[1], b.p[1], settle),
            lerp(a.p[2], b.p[2], settle),
          ],
          n: norm(vLerp(a.n, b.n, settle)),
        });
      }
      pushCloud(dots, morphCloud, null, camera, lightDir, 'pcb', 0.84);

      // Reinforce the finished bare board after the morph, so traces and pads
      // become crisp before component placement begins.
      if (bareHold > 0) {
        pushCloud(dots, PCB_ASSEMBLY_BOARD_CLOUD, null, camera, lightDir, 'pcb', 0.18 + 0.55 * bareHold);
        for (const cloud of PCB_ASSEMBLY_TRACE_CLOUDS) {
          pushCloud(dots, cloud, null, camera, lightDir, 'pcb-detail', 0.12 + 0.62 * bareHold);
        }
        for (const cloud of PCB_ASSEMBLY_PAD_CLOUDS) {
          pushCloud(dots, cloud, null, camera, lightDir, 'pcb-detail', 0.18 + 0.60 * bareHold);
        }
      }

      // 50-94%: components arrive one at a time from above and settle onto pads.
      const population = clamp((t - 0.50) / 0.44);
      const componentCount = PCB_ASSEMBLY_COMPONENT_CLOUDS.length;
      const travelWindow = 0.92 / componentCount;

      for (let i = 0; i < componentCount; i++) {
        const start = i * travelWindow;
        const local = clamp((population - start) / (travelWindow * 0.76));
        if (local <= 0) continue;

        const settle = easeInOut(local);
        const dropHeight = (1 - settle) * (0.40 + 0.06 * (i % 3));
        const tinyOvershoot = local > 0.80
          ? -0.010 * Math.sin(((local - 0.80) / 0.20) * PI)
          : 0;
        const frame = { R: IDENTITY, t: [0, dropHeight + tinyOvershoot, 0] };
        const active = local < 0.96;

        pushCloud(
          dots,
          PCB_ASSEMBLY_COMPONENT_CLOUDS[i],
          frame,
          camera,
          lightDir,
          active ? 'pin-active' : 'pcb',
          active ? 0.92 + settle * 0.30 : 0.86,
          active ? 'blue' : 'black',
        );
      }

      const boardAnchor = project([0, 0, 0], camera);
      fitAnchoredDots(dots, boardAnchor, state.assemblyFit, {
        screenX: 0.53,
        screenY: 0.56,
        left: 0.04,
        right: 0.985,
        top: 0.04,
        bottom: 0.955,
      });

      sizeAndDrawDots(dots);
    }

    function withCanvasAlpha(alpha, drawFn) {
      ctx.save();
      ctx.globalAlpha = clamp(alpha);
      drawFn();
      ctx.restore();
    }

    function transitionSceneFade(blend) {
      // Only cross-dissolve near the end of the morph. This lets the geometry
      // finish transforming first, then hands off smoothly to the real scene
      // in its own native camera/scale without a positional snap.
      return smooth(clamp((blend - 0.72) / 0.28));
    }

    function render(timeSeconds, deltaSeconds = 0) {
      // ResizeObserver owns all layout measurements. No getBoundingClientRect()
      // or canvas resize work occurs in the animation loop.
      ctx.clearRect(0, 0, state.width, state.height);

      const loopTime = state.reducedMotion ? 0 : (timeSeconds % LOOP_DURATION);
      const robotEnd = ROBOT_SCENE_DURATION;
      const robotToBedEnd = robotEnd + SCENE_TRANSITION_DURATION;
      const bedEnd = robotToBedEnd + BED_SCENE_DURATION;
      const bedToAssemblyEnd = bedEnd + SCENE_TRANSITION_DURATION;
      const assemblyEnd = bedToAssemblyEnd + ASSEMBLY_SCENE_DURATION;

      if (loopTime < robotEnd) {
        updateCaption('Robotic surface registration');
        setScene('robot');
        drawHeartRegistrationScene(
          loopTime,
          ROBOT_SCENE_DURATION,
          timeSeconds,
          deltaSeconds,
        );
      } else if (loopTime < robotToBedEnd) {
        const blend = (loopTime - robotEnd) / SCENE_TRANSITION_DURATION;
        const handoff = transitionSceneFade(blend);

        updateCaption(
          'Robotic surface registration',
          'Bed of nails for automated test',
          blend,
        );

        withCanvasAlpha(1 - handoff, () => {
          drawMorphTransition(
            blend,
            ROBOT_EXIT_TRANSITION_CLOUD,
            BED_ENTRY_TRANSITION_CLOUD,
            timeSeconds,
          );
        });

        if (handoff > 0) {
          setScene('bed');
          withCanvasAlpha(handoff, () => {
            drawBedOfNailsScene(0, BED_SCENE_DURATION, timeSeconds);
          });
        }
      } else if (loopTime < bedEnd) {
        updateCaption('Bed of nails for automated test');
        setScene('bed');
        drawBedOfNailsScene(
          loopTime - robotToBedEnd,
          BED_SCENE_DURATION,
          timeSeconds,
        );
      } else if (loopTime < bedToAssemblyEnd) {
        const blend = (loopTime - bedEnd) / SCENE_TRANSITION_DURATION;
        const handoff = transitionSceneFade(blend);

        updateCaption(
          'Bed of nails for automated test',
          'PCB design and fabrication',
          blend,
        );

        withCanvasAlpha(1 - handoff, () => {
          drawMorphTransition(
            blend,
            BED_EXIT_TRANSITION_CLOUD,
            ASSEMBLY_ENTRY_TRANSITION_CLOUD,
            timeSeconds,
          );
        });

        if (handoff > 0) {
          setScene('assembly');
          withCanvasAlpha(handoff, () => {
            drawAssemblyScene(0, ASSEMBLY_SCENE_DURATION, timeSeconds);
          });
        }
      } else if (loopTime < assemblyEnd) {
        updateCaption('PCB design and fabrication');
        setScene('assembly');
        drawAssemblyScene(
          loopTime - bedToAssemblyEnd,
          ASSEMBLY_SCENE_DURATION,
          timeSeconds,
        );
      } else {
        const blend = (loopTime - assemblyEnd) / SCENE_TRANSITION_DURATION;
        const handoff = transitionSceneFade(blend);

        updateCaption(
          'PCB design and fabrication',
          'Robotic surface registration',
          blend,
        );

        withCanvasAlpha(1 - handoff, () => {
          drawMorphTransition(
            blend,
            ASSEMBLY_EXIT_TRANSITION_CLOUD,
            ROBOT_ENTRY_TRANSITION_CLOUD,
            timeSeconds,
          );
        });

        if (handoff > 0) {
          setScene('robot');
          withCanvasAlpha(handoff, () => {
            drawHeartRegistrationScene(
              0,
              ROBOT_SCENE_DURATION,
              timeSeconds,
              deltaSeconds,
            );
          });
        }
      }
    }

    function frame(nowMs) {
      const deltaSeconds = state.lastFrameMs === null
        ? SIMULATION_DT
        : Math.min((nowMs - state.lastFrameMs) * 0.001, 0.05);
      state.lastFrameMs = nowMs;

      render(nowMs * 0.001, deltaSeconds);
      if (state.running) state.raf = requestAnimationFrame(frame);
    }

    function start() {
      if (state.running) return;
      state.running = true;
      state.lastFrameMs = null;
      state.nextSimulationTime = null;
      state.raf = requestAnimationFrame(frame);
    }

    function stop() {
      state.running = false;
      cancelAnimationFrame(state.raf);
      state.lastFrameMs = null;
      state.nextSimulationTime = null;
    }

    function sync() {
      const shouldRun = state.visible && !document.hidden && !state.reducedMotion;
      if (shouldRun) start();
      else stop();
    }

    resize();
    render(0, 0);
    sync();
  })();
</script>