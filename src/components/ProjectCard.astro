---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<details class="project-card">
  <summary>
    <div class="project-heading">
      <div>
        <h3>{project.title}</h3>
        <p class="project-summary">{project.summary}</p>
      </div>

      <span class="expand">+</span>
    </div>
  </summary>

  <div class="project-content">
    <div class="details">
      {
        project.details.map((block) => {
          if (block.type === "text") {
            return (
              <p>
                {block.content}
              </p>
            );
          }

          if (block.type === "image") {
            return (
              <figure class="project-image">
                <img
                  src={block.src}
                  alt={block.alt}
                  loading="lazy"
                />

                {
                  block.caption && (
                    <figcaption>
                      {block.caption}
                    </figcaption>
                  )
                }
              </figure>
            );
          }

          if (block.type === "video") {
            return (
              <figure class="project-video">
                <div class="video-wrapper">
                  <iframe
                    //src={`https://www.youtube-nocookie.com/embed/${block.youtubeId}`}
                    src={`https://www.youtube.com/embed/${block.youtubeId}`}
                    title={block.caption ?? "Project video"}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  />
                </div>

                {
                  block.caption && (
                    <figcaption>
                      {block.caption}
                    </figcaption>
                  )
                }
              </figure>
            );
          }

          if (block.type === "mermaid") {
            return (
              <figure class="project-mermaid">
                <div class="mermaid">
                  {block.content}
                </div>

                <details class="mermaid-source">
                  <summary class="uml-source-link">
                    View UML source

                    <span
                      class="external-link"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </summary>

                  <pre>
                    <code>{block.content.trim()}</code>
                  </pre>
                </details>

                {
                  block.caption && (
                    <figcaption>
                      {block.caption}
                    </figcaption>
                  )
                }
              </figure>
            );
          }

          return null;
        })
      }
    </div>

    {
      project.links && project.links.length > 0 && (
        <div class="project-links">
          {project.links.map((link) => (
            <a
              class="project-link"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}

              <span
                class="external-link"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))}
        </div>
      )
    }

    {
      project.tags.length > 0 && (
        <div class="metadata">
          <span class="metadata-title">Areas</span>

          <div class="items">
            {
              project.tags.map((tag) => (
                <span>{tag}</span>
              ))
            }
          </div>
        </div>
      )
    }

    {
      project.technologies.length > 0 && (
        <div class="metadata">
          <span class="metadata-title">Technologies</span>

          <div class="items">
            {
              project.technologies.map((technology) => (
                <span>{technology}</span>
              ))
            }
          </div>
        </div>
      )
    }
  </div>
</details>

<script>
  import mermaid from "mermaid";

  mermaid.initialize({
    startOnLoad: false,
    theme: "neutral",
  });

  async function renderMermaid() {
    await mermaid.run({
      querySelector: ".mermaid",
    });
  }

  renderMermaid();

  document
    .querySelectorAll<HTMLDetailsElement>("details.project-card")
    .forEach((details) => {
      details.addEventListener("toggle", () => {
        if (details.open) {
          renderMermaid();
        }
      });
    });
</script>

<style>
  .project-card {
    border-top: 1px solid #d8d8d8;

    background: #f7f7f7;

    padding: 0 1.25rem;
  }

  .project-card:last-child {
    border-bottom: 1px solid #d8d8d8;
  }

  summary {
    list-style: none;
    cursor: pointer;

    padding: 2rem 0;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .project-summary {
    font-weight: 700;
  }

  .project-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    gap: 2rem;
  }

  .project-heading h3 {
    margin: 0 0 0.75rem;

    color: #111;

    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .project-heading p {
    margin: 0;

    max-width: 700px;

    color: #555;

    line-height: 1.7;
  }

  .expand {
    flex-shrink: 0;

    color: #111;

    font-size: 1.8rem;
    line-height: 1;

    transition: transform 0.15s ease;
  }

  details[open] .expand {
    transform: rotate(45deg);
  }

  .project-content {
    max-width: 750px;

    padding: 0 0 2.5rem;
  }

  .details {
    margin: 0 0 2rem;

    color: #444;

    line-height: 1.8;
  }

  .details p {
    margin: 0 0 1.5rem;
  }

  .details p:last-child {
    margin-bottom: 0;
  }

  .project-image {
    margin: 2rem 0;
  }

  .project-image img {
    display: block;

    width: 100%;
    height: auto;

    border-radius: 4px;
  }

  .project-image figcaption {
    margin-top: 0.6rem;

    color: #777;

    font-size: 0.85rem;
    line-height: 1.5;
  }

  .project-video {
  margin: 2rem 0;
  }

  .video-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;

    overflow: hidden;

    background: #000;

    border-radius: 4px;
  }

  .video-wrapper iframe {
    display: block;

    width: 100%;
    height: 100%;

    border: 0;
  }

  .project-video figcaption {
    margin-top: 0.6rem;

    color: #777;

    font-size: 0.85rem;
    line-height: 1.5;
  }

  .project-mermaid {
    margin: 2rem 0;
  }

  .project-mermaid .mermaid {
    overflow-x: auto;

    padding: 1.5rem;

    background: #fff;

    border: 1px solid #ddd;
    border-radius: 4px;
  }

  .mermaid-source {
    margin-top: 0.8rem;
  }

  .uml-source-link {
    display: inline-flex;
    align-items: baseline;

    padding: 0;

    color: #1c1c1c;

    font-size: 0.95rem;
    font-weight: 500;

    list-style: none;
    cursor: pointer;
  }

  .uml-source-link::-webkit-details-marker {
    display: none;
  }

  .uml-source-link:hover {
    text-decoration: underline;
  }

  .uml-source-link:hover .external-link {
    transform: translate(2px, -2px);
  }

  .mermaid-source pre {
    margin: 1rem 0 0;

    padding: 1rem;

    overflow-x: auto;

    background: #fff;

    border: 1px solid #ddd;
    border-radius: 4px;

    color: #333;

    font-family: monospace;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .mermaid-source code {
    white-space: pre;
  }

  .project-mermaid figcaption {
    margin-top: 0.6rem;

    color: #777;

    font-size: 0.85rem;
    line-height: 1.5;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;

    gap: 0.75rem 1.75rem;

    margin: -0.5rem 0 2rem;
  }

  .project-link {
    display: inline-flex;
    align-items: baseline;

    color: #1c1c1c;

    font-size: 0.95rem;
    font-weight: 500;

    text-decoration: none;
  }

  .project-link:visited {
    color: #1c1c1c;
  }

  .project-link:hover {
    text-decoration: underline;
  }

  .external-link {
    display: inline-block;

    margin-left: 0.35rem;

    font-size: 0.8em;
    font-weight: 400;

    transition: transform 0.15s ease;
  }

  .project-link:hover .external-link {
    transform: translate(2px, -2px);
  }

  .metadata {
    margin-top: 1.5rem;
  }

  .metadata-title {
    display: block;

    margin-bottom: 0.7rem;

    color: #777;

    font-size: 0.8rem;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .items {
    display: flex;
    flex-wrap: wrap;

    gap: 0.5rem;
  }

  .items span {
    border: 1px solid #ccc;
    border-radius: 100px;

    padding: 0.35rem 0.75rem;

    background: #fff;

    color: #444;

    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .project-card {
      padding: 0 1rem;
    }

    summary {
      padding: 1.5rem 0;
    }

    .uml-source-link {
      padding: 0;
    }

    .project-heading {
      gap: 1rem;
    }

    .project-heading h3 {
      margin-bottom: 0.6rem;

      font-size: 1.1rem;
      line-height: 1.35;
    }

    .project-heading p {
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .expand {
      font-size: 1.4rem;
    }

    .project-image {
      margin: 1.5rem 0;
    }

  .project-video {
      margin: 1.5rem 0;
    }

    .project-mermaid {
      margin: 1.5rem 0;
    }

    .project-mermaid .mermaid {
      padding: 1rem;
    }

    .mermaid-source pre {
      padding: 0.8rem;

      font-size: 0.8rem;
    }
  }
</style>