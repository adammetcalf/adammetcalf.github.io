---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Adam Metcalf",
  description = "Adam Metcalf — Robotics, Systems Engineering and Software.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
  </head>

  <body>
    <nav>
      <a class="name" href="/">Home</a>

      <div class="nav-links">
        <a href="/projects">Projects</a>
        <a href="/cv">CV</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </div>
    </nav>

    <slot />

    <footer id="contact">
      <span>© {new Date().getFullYear()} Adam Metcalf</span>

      <div>
        <a href="https://www.github.com/adammetcalf">GitHub</a>
        <span class="footer-separator">·</span>
        <a href="https://www.linkedin.com/in/adammetcalf/">LinkedIn</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    color: #1c1c1c;
    background: #fafafa;
  }

  * {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    width: 100%;
    min-height: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;

    width: min(1100px, calc(100% - 3rem));
    margin: auto;
    padding: 2rem 0;
  }

  nav a {
    color: inherit;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .name {
    font-weight: 700;
  }

  footer {
    width: min(1100px, calc(100% - 3rem));

    margin: auto;
    padding: 3rem 0;

    border-top: 1px solid #ddd;

    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  footer a {
    color: inherit;
  }

  .footer-separator {
    margin: 0 0.75rem;
    color: #999;
  }

  @media (max-width: 700px) {
    nav {
      align-items: flex-start;
      gap: 2rem;
    }

    .nav-links {
      gap: 1rem;
    }

    footer {
      flex-direction: column;
      gap: 1rem;
    }
  }

  @media (max-width: 500px) {
    nav {
      flex-direction: column;
      gap: 1.25rem;
    }

    .nav-links {
      width: 100%;
      justify-content: space-between;
      gap: 0.5rem;
    }
  }
</style>